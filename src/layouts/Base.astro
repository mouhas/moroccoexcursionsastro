---
import '../styles/global.css';
import '../styles/newtheme-scoped.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { type Lang } from '../site';
import { getSettings } from '../lib/settings';
import { shadeRamp } from '../lib/color';
import { googleFontsUrl, fontOption } from '../lib/fonts';

interface Props {
  title: string;
  description?: string;
  lang: Lang;
  // Precise cross-language equivalents for hreflang tags, keyed by language,
  // e.g. { en: '/', fr: '/fr/', es: '/es/' }. Pass null/omit when this exact
  // page has no confirmed translated equivalent — a wrong hreflang claim is
  // worse than none, so we never guess here (see site.ts's langAlternates()).
  alternates?: Partial<Record<Lang, string>> | null;
  section?: 'home' | 'pages' | 'tours' | 'cars';
  pslug?: string;
  // Individual tour detail pages keep their original body content (gallery,
  // pricing, itinerary — all still styled by global.css) — set true only for
  // those (see [...path].astro's isTour). Header and footer use the new
  // theme everywhere, tour pages included, so each gets its own standalone
  // .newtheme wrapper instead of sharing one with <main>.
  legacyTheme?: boolean;
}
const { title, description = 'Private Morocco desert tours, camel treks in Merzouga and tailor-made journeys by a 100% local Berber team. Rated 5/5 from 820+ travellers.', lang, alternates = null, section = 'home', pslug, legacyTheme = false } = Astro.props;
const htmlLang = lang === 'pt-br' ? 'pt-BR' : lang;
const site = 'https://morocco-excursion.com';
const canonical = site + Astro.url.pathname;

const settings = await getSettings();
const accentRamp = shadeRamp(settings.accentColor);
const accent2Ramp = shadeRamp(settings.accentColor2);
const headingFont = fontOption(settings.headingFont);
const bodyFont = fontOption(settings.bodyFont);
const fontsUrl = googleFontsUrl(settings.headingFont, settings.bodyFont);
---
<!DOCTYPE html>
<html lang={htmlLang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script is:inline>
    (function () {
      try {
        var saved = localStorage.getItem('theme');
        var theme = saved || (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        if (theme === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
      } catch (e) {}
    })();
  </script>
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {alternates && Object.entries(alternates).map(([l, href]) => (
    <link rel="alternate" hreflang={l === 'pt-br' ? 'pt-BR' : l} href={site + href} />
  ))}
  {alternates && <link rel="alternate" hreflang="x-default" href={site + (alternates.en ?? Object.values(alternates)[0])} />}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href={fontsUrl} rel="stylesheet" />
  {/* Two separate style systems actually ship the site's look: the
      ".newtheme"-scoped tokens (src/styles/newtheme-scoped.css — header,
      footer, and most pages) and global.css's plain :root tokens (legacy
      --orange/--blue names, used by individual tour-detail pages' body
      content). Both need overriding for a color/font change to actually
      show up everywhere. Uses !important because newtheme-scoped.css's
      own ".newtheme{...}" block is bundled after this tag in the compiled
      output — without it, that later same-specificity rule wins the
      cascade and silently no-ops every override below. */}
  <style set:html={`
    .newtheme{
      --font-heading:"${headingFont.family}",${headingFont.fallback} !important;
      --font-body:"${bodyFont.family}",${bodyFont.fallback} !important;
      --color-accent:${accentRamp[500]} !important;--color-accent-2:${accent2Ramp[500]} !important;
      --color-accent-100:${accentRamp[100]} !important;--color-accent-200:${accentRamp[200]} !important;--color-accent-300:${accentRamp[300]} !important;
      --color-accent-400:${accentRamp[400]} !important;--color-accent-500:${accentRamp[500]} !important;--color-accent-600:${accentRamp[600]} !important;
      --color-accent-700:${accentRamp[700]} !important;--color-accent-800:${accentRamp[800]} !important;--color-accent-900:${accentRamp[900]} !important;
      --color-accent-2-100:${accent2Ramp[100]} !important;--color-accent-2-200:${accent2Ramp[200]} !important;--color-accent-2-300:${accent2Ramp[300]} !important;
      --color-accent-2-400:${accent2Ramp[400]} !important;--color-accent-2-500:${accent2Ramp[500]} !important;--color-accent-2-600:${accent2Ramp[600]} !important;
      --color-accent-2-700:${accent2Ramp[700]} !important;--color-accent-2-800:${accent2Ramp[800]} !important;--color-accent-2-900:${accent2Ramp[900]} !important;
    }
    :root{
      --font-size-base:${settings.baseFontSize}px !important;
      --legacy-font-body:"${bodyFont.family}",${bodyFont.fallback} !important;
      --legacy-font-heading:"${headingFont.family}",${headingFont.fallback} !important;
      --orange:${accentRamp[500]} !important;--orange-dk:${accentRamp[700]} !important;--orange-hover:${accentRamp[800]} !important;--orange-lt:${accentRamp[100]} !important;
      --blue:${accent2Ramp[700]} !important;--blue-2:${accent2Ramp[500]} !important;--blue-dk:${accent2Ramp[800]} !important;--blue-lt:${accent2Ramp[100]} !important;
    }
    html{font-size:var(--font-size-base)}
  `} />
</head>
<body>
  {legacyTheme ? (
    <>
      <Header lang={lang} section={section} pslug={pslug} />
      <main>
        <slot />
      </main>
      <Footer lang={lang} />
    </>
  ) : (
    <div class="newtheme" style="display:flex;flex-direction:column;min-height:100vh">
      <Header lang={lang} section={section} pslug={pslug} />
      <main style="flex:1;max-width:1180px;width:100%;margin:0 auto">
        <slot />
      </main>
      <Footer lang={lang} />
    </div>
  )}
</body>
</html>
