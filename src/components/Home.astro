    typeOpts: ['Tous types', 'Circuit multi-jours', 'Excursion d’une journée', 'Camp du désert', 'Location de voiture', 'Sur mesure'],
    durOpts: ['Toute durée', '1 jour', '2–4 jours', '5–7 jours', '8+ jours'],
    travOpts: ['2 voyageurs', '1 voyageur', '3–4 voyageurs', '5+ / groupe privé'],
    popEye: 'Voyages sélectionnés', popH: 'Circuits & excursions populaires',
    popP: 'Chaque départ est privé, flexible et guidé par un local — filtrez la liste complète pour trouver le vôtre.',
    journeysEye: 'Circuits en vedette', journeysH: 'D’autres façons de voir le Maroc',
    destEye: 'Où aller', destH: 'Explorer par destination',
    whyEye: 'Pourquoi nous choisir', whyH: 'Pourquoi Morocco Excursions ?',
    feats: [['100 % local & indépendant', 'Créée et détenue à 100 % par des experts berbères — familles locales du désert du sud marocain.'], ['Entièrement personnalisable', 'Circuits de 1 à 30 jours, privés ou en groupe, adaptés à vos envies.'], ['De confiance depuis 2008', 'Des voyages uniques au Maroc depuis plus de 15 ans, avec une attention portée au tourisme durable et local.'], ['Nous parlons votre langue', 'Anglais, Français, Espagnol, Italien & Portugais — assistance 24/7.']],
    revEye: 'Adoré des voyageurs', revH: 'Ce que disent nos clients', revP: 'De vrais avis de récents clients de Morocco Excursions.',
    ctaEye: 'Prêt quand vous l’êtes', ctaH: 'Dites-nous vos dates et vos envies', ctaP: 'Notre équipe locale créera un itinéraire privé rien que pour vous — sans pression ni frais cachés.',
    ctaBtn: 'Voir les circuits', readReviews: 'Tous les avis →',
    perPerson: 'pp', from: 'à partir de', notRated: 'Pas encore noté',
  },
  es: {
    eyebrowHero: 'Viajes en pequeño grupo por Marruecos',
    h1: 'El desierto, la medina, y todo lo demás',
    lead: 'Un equipo 100% local, de propiedad bereber, con tours privados y en pequeño grupo desde 2008 — desde excursiones de un día hasta aventuras de un mes, a tu medida.',
    explore: 'Ver tours', custom: 'Viaje personalizado',
    searchTitle: 'Encuentra tu viaje',
    destLabel: 'Destino', typeLabel: 'Tipo de viaje', durLabel: 'Duración', travLabel: 'Viajeros', search: 'Buscar',
    destOpts: ['Todo Marruecos', 'Marrakech y el Atlas', 'Fez y ciudades imperiales', 'Sáhara y Merzouga', 'Essaouira y la costa', 'Chefchaouen y el Rif'],
    typeOpts: ['Cualquier tipo', 'Tour de varios días', 'Excursión de un día', 'Campamento del desierto', 'Alquiler de coche', 'A medida'],
    durOpts: ['Cualquier duración', '1 día', '2–4 días', '5–7 días', '8+ días'],
    travOpts: ['2 viajeros', '1 viajero', '3–4 viajeros', '5+ / grupo privado'],
    popEye: 'Viajes seleccionados', popH: 'Tours y excursiones populares',
    popP: 'Cada salida es privada, flexible y guiada por un local — filtra la lista completa para encontrar la tuya.',
    journeysEye: 'Viajes destacados', journeysH: 'Más formas de ver Marruecos',
    destEye: 'A dónde ir', destH: 'Explorar por destino',
    whyEye: 'Por qué elegirnos', whyH: '¿Por qué Morocco Excursions?',
    feats: [['100% local e independiente', 'Creada y propiedad de expertos bereberes — familias locales del desierto del sur de Marruecos.'], ['Totalmente personalizable', 'Viajes de 1 a 30 días, privados o en grupo, adaptados a lo que buscas.'], ['De confianza desde 2008', 'Creando viajes únicos a Marruecos desde hace más de 15 años, con enfoque en el turismo sostenible y local.'], ['Hablamos tu idioma', 'Inglés, Francés, Español, Italiano y Portugués — soporte 24/7.']],
    revEye: 'Amado por viajeros', revH: 'Lo que dicen nuestros clientes', revP: 'Opiniones reales de clientes recientes de Morocco Excursions.',
    ctaEye: 'Listos cuando tú lo estés', ctaH: 'Cuéntanos tus fechas y sueños', ctaP: 'Nuestro equipo local creará un itinerario privado solo para ti — sin presión ni costes ocultos.',
    ctaBtn: 'Ver tours', readReviews: 'Ver todas las reseñas →',
    perPerson: 'pp', from: 'desde', notRated: 'Aún sin valorar',
  },
  it: {
    eyebrowHero: 'Viaggi in piccolo gruppo in tutto il Marocco',
    h1: 'Il deserto, la medina, e tutto quello che c’è in mezzo',
    lead: 'Un team 100% locale, di proprietà berbera, che organizza tour privati e in piccolo gruppo dal 2008 — da escursioni di un giorno a viaggi di un mese, su misura.',
    explore: 'Scopri i tour', custom: 'Viaggio su misura',
    searchTitle: 'Trova il tuo viaggio',
    destLabel: 'Destinazione', typeLabel: 'Tipo di viaggio', durLabel: 'Durata', travLabel: 'Viaggiatori', search: 'Cerca',
    destOpts: ['Tutto il Marocco', 'Marrakech e l’Atlante', 'Fes e le città imperiali', 'Sahara e Merzouga', 'Essaouira e la costa', 'Chefchaouen e il Rif'],
    typeOpts: ['Qualsiasi tipo', 'Tour di più giorni', 'Escursione di un giorno', 'Campo nel deserto', 'Noleggio auto', 'Su misura'],
    durOpts: ['Qualsiasi durata', '1 giorno', '2–4 giorni', '5–7 giorni', '8+ giorni'],
    travOpts: ['2 viaggiatori', '1 viaggiatore', '3–4 viaggiatori', '5+ / gruppo privato'],
    popEye: 'Viaggi selezionati', popH: 'Tour ed escursioni popolari',
    popP: 'Ogni partenza è privata, flessibile e guidata da un locale — filtra l’elenco completo per trovare la tua.',
    journeysEye: 'Viaggi in evidenza', journeysH: 'Altri modi per vedere il Marocco',
    destEye: 'Dove andare', destH: 'Esplora per destinazione',
    whyEye: 'Perché sceglierci', whyH: 'Perché Morocco Excursions?',
    feats: [['100% locale e indipendente', 'Creata e posseduta da esperti berberi — famiglie locali del deserto a sud del Marocco.'], ['Totalmente personalizzabile', 'Tour da 1 a 30 giorni, privati o di gruppo, su misura per te.'], ['Affidabili dal 2008', 'Viaggi unici in Marocco da oltre 15 anni, con attenzione al turismo sostenibile e locale.'], ['Parliamo la tua lingua', 'Inglese, Francese, Spagnolo, Italiano e Portoghese — supporto 24/7.']],
    revEye: 'Amato dai viaggiatori', revH: 'Cosa dicono i nostri ospiti', revP: 'Recensioni reali di clienti recenti di Morocco Excursions.',
    ctaEye: 'Pronti quando lo sei tu', ctaH: 'Dicci le tue date e i tuoi sogni', ctaP: 'Il nostro team locale creerà un itinerario privato solo per te — senza pressioni né costi nascosti.',
    ctaBtn: 'Scopri i tour', readReviews: 'Tutte le recensioni →',
    perPerson: 'pp', from: 'da', notRated: 'Non ancora valutato',
  },
  'pt-br': {
    eyebrowHero: 'Viagens em pequenos grupos por Marrocos',
    h1: 'O deserto, a medina, e tudo o que há entre eles',
    lead: 'Uma equipe 100% local, de propriedade berbere, com passeios privados e em pequenos grupos desde 2008 — de excursões de um dia a viagens de um mês, sob medida.',
    explore: 'Ver tours', custom: 'Viagem personalizada',
    searchTitle: 'Encontre sua viagem',
    destLabel: 'Destino', typeLabel: 'Tipo de viagem', durLabel: 'Duração', travLabel: 'Viajantes', search: 'Buscar',
    destOpts: ['Todo o Marrocos', 'Marrakech e o Atlas', 'Fez e cidades imperiais', 'Saara e Merzouga', 'Essaouira e o litoral', 'Chefchaouen e o Rif'],
    typeOpts: ['Qualquer tipo', 'Tour de vários dias', 'Excursão de um dia', 'Acampamento no deserto', 'Aluguel de carro', 'Sob medida'],
    durOpts: ['Qualquer duração', '1 dia', '2–4 dias', '5–7 dias', '8+ dias'],
    travOpts: ['2 viajantes', '1 viajante', '3–4 viajantes', '5+ / grupo privado'],
    popEye: 'Viagens selecionadas', popH: 'Tours e excursões populares',
    popP: 'Cada saída é privada, flexível e guiada por um local — filtre a lista completa para encontrar a sua.',
    journeysEye: 'Viagens em destaque', journeysH: 'Mais formas de ver Marrocos',
    destEye: 'Para onde ir', destH: 'Explore por destino',
    whyEye: 'Por que viajar conosco', whyH: 'Por que Morocco Excursions?',
    feats: [['100% local e independente', 'Criada e administrada por especialistas berberes — famílias locais do deserto ao sul do Marrocos.'], ['Totalmente personalizável', 'Passeios de 1 a 30 dias, privados ou em grupo, sob medida para você.'], ['De confiança desde 2008', 'Criando viagens únicas pelo Marrocos há mais de 15 anos, com foco em turismo sustentável e local.'], ['Falamos o seu idioma', 'Inglês, Francês, Espanhol, Italiano e Português — suporte 24/7.']],
    revEye: 'Amado pelos viajantes', revH: 'O que nossos clientes dizem', revP: 'Avaliações reais de clientes recentes da Morocco Excursions.',
    ctaEye: 'Prontos quando você estiver', ctaH: 'Conte-nos suas datas e sonhos', ctaP: 'Nossa equipe local criará um roteiro privado só para você — sem pressão nem custos ocultos.',
    ctaBtn: 'Ver tours', readReviews: 'Ver todas as avaliações →',
    perPerson: 'pp', from: 'a partir de', notRated: 'Ainda sem avaliação',
  },
};
const c = COPY[lang];

const all = await getCollection('site', (e) => e.data.lang === lang && e.data.section === 'tours' && e.data.price);
all.sort((a, z) => (z.data.rating ?? 0) - (a.data.rating ?? 0) || (z.data.reviewCount ?? 0) - (a.data.reviewCount ?? 0));
const featured = all.slice(0, 6);
const journeys = all.slice(6, 10);

const dests = ['Merzouga & the Sahara', 'Marrakech', 'Fes & Meknes', 'Chefchaouen', 'Ouarzazate', 'Essaouira'];

const stats = [
  ['145+', 'Tours and excursions run across Morocco, from single days to month-long routes.'],
  ['100%', 'Local and Berber-owned. Guides and drivers are all local partners.'],
  ['5', 'Languages spoken by the team: English, French, Spanish, Italian and Portuguese.'],
  ['24/7', 'In-country trip support, before, during and after your journey.'],
];

const reviews = GENERAL_REVIEWS[lang] ?? GENERAL_REVIEWS.en;
---
<section class="ph" style="border-radius:0;box-shadow:none;min-height:520px;display:flex;align-items:center;padding:0 max(40px, calc((100% - 1180px) / 2));width:100vw;margin-left:calc(50% - 50vw);margin-right:calc(50% - 50vw)">
  <div style="position:absolute;inset:0;background:linear-gradient(90deg,rgba(10,36,64,.82) 0%,rgba(10,36,64,.55) 55%,rgba(10,36,64,.25) 100%)"></div>
  <span style="bottom:auto;top:16px;right:16px;left:auto">photo — Sahara dunes at golden hour</span>
  <div style="position:relative;max-width:720px;color:#fff">
    <span class="tag tag-accent" style="background:var(--color-accent);color:#fff">{c.eyebrowHero}</span>
    <h1 style="font-size:clamp(32px,5vw,58px);line-height:1.05;margin:18px 0 16px;color:#fff">{c.h1}</h1>
    <p style="font-size:clamp(16px,2vw,18px);line-height:1.6;color:rgba(255,255,255,.86);max-width:560px;margin:0 0 28px">{c.lead}</p>
    <div style="display:flex;gap:12px;flex-wrap:wrap">
      <a href={b + '/tours'} class="btn btn-primary" style="font-size:16px;padding:15px 30px">{c.explore}</a>
      <a href={b + '/travel-agency'} class="btn" style="font-size:16px;padding:15px 30px;background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.5);color:#fff">{c.custom}</a>
    </div>
  </div>
</section>

<section style="padding:0 40px;margin-top:-38px;position:relative;z-index:10">
  <form action={b + '/tours'} style="background:var(--color-bg);border:1px solid var(--color-divider);border-radius:var(--radius-md);box-shadow:var(--shadow-md);padding:16px">
    <div style="display:grid;grid-template-columns:1.2fr 1fr 1fr 1fr auto;gap:10px;align-items:end">
      <div style="display:grid;gap:5px">
        <label style="font-size:11px;font-weight:600;color:var(--color-neutral-600)">{c.destLabel}</label>
        <select class="input">{c.destOpts.map((o: string) => <option>{o}</option>)}</select>
      </div>
      <div style="display:grid;gap:5px">
        <label style="font-size:11px;font-weight:600;color:var(--color-neutral-600)">{c.typeLabel}</label>
        <select class="input">{c.typeOpts.map((o: string) => <option>{o}</option>)}</select>
      </div>
      <div style="display:grid;gap:5px">
        <label style="font-size:11px;font-weight:600;color:var(--color-neutral-600)">{c.durLabel}</label>
        <select class="input">{c.durOpts.map((o: string) => <option>{o}</option>)}</select>
      </div>
      <div style="display:grid;gap:5px">
        <label style="font-size:11px;font-weight:600;color:var(--color-neutral-600)">{c.travLabel}</label>
        <select class="input">{c.travOpts.map((o: string) => <option>{o}</option>)}</select>
      </div>
      <button type="submit" class="btn btn-blue">{c.search}</button>
    </div>
  </form>
</section>

<section style="padding:72px 40px 88px">
  <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:40px;margin-bottom:32px;flex-wrap:wrap">
    <div>
      <span class="mono" style="color:var(--color-accent-700)">{c.popEye}</span>
      <h2 style="font-size:clamp(28px,4vw,48px);margin:12px 0 0">{c.popH}</h2>
    </div>
    <p style="font-size:16px;line-height:1.6;color:var(--color-neutral-700);max-width:360px;margin:0">{c.popP}</p>
  </div>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px">
    {featured.map((e) => (
      <a href={'/' + e.data.urlPath} style="display:flex;flex-direction:column;border:1px solid var(--color-divider);border-radius:var(--radius-md);overflow:hidden;color:inherit;text-decoration:none">
        <div class="ph" style="height:190px;border-radius:0;box-shadow:none"><span>photo — {e.data.title}</span></div>
        <div style="padding:14px 16px 16px;display:flex;flex-direction:column;gap:6px;flex:1">
          {e.data.rating ? (
            <div style="display:flex;align-items:center;gap:6px">
              <span style="color:var(--color-accent);font-size:13px">★</span>
              <span style="font-size:13px;font-weight:600">{e.data.rating.toFixed(1)}</span>
              <span style="font-size:12px;color:var(--color-neutral-600)">({e.data.reviewCount ?? 0})</span>
            </div>
          ) : <p style="font-size:12px;color:var(--color-neutral-600);margin:0">{c.notRated}</p>}
          <h3 style="font-size:17px;margin:0">{e.data.title}</h3>
          <p style="font-size:12px;color:var(--color-neutral-600);margin:0 0 6px">{e.data.tourType}{e.data.duration ? ' · ' + e.data.duration : ''}</p>
          <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin:8px 0 12px;padding-top:10px;border-top:1px solid var(--color-divider);font-size:12px;color:var(--color-neutral-700)">
            <span style="display:inline-flex;align-items:center;gap:5px"><Icon name="user" class="ico sm" />{e.data.tourType}</span>
            <span style="display:inline-flex;align-items:center;gap:5px"><Icon name="globe" class="ico sm" />EN·FR·ES·IT·PT</span>
          </div>
          <p style="font-size:12px;color:var(--color-neutral-600);margin:auto 0 0">{c.from} <span style="font-size:18px;font-weight:700;color:var(--color-accent-700)">€{e.data.price?.toLocaleString('en-US')}</span> {c.perPerson}</p>
        </div>
      </a>
    ))}
  </div>
  <div style="text-align:center;margin-top:32px"><a href={b + '/tours'} class="btn btn-secondary" style="border-radius:10px">{t.viewAll} →</a></div>
</section>

{journeys.length > 0 && (
  <section style="padding:0 40px 88px">
    <div style="display:flex;align-items:baseline;justify-content:space-between;margin-bottom:12px;flex-wrap:wrap;gap:8px">
      <div>
        <span class="mono" style="color:var(--color-accent-700)">{c.journeysEye}</span>
        <h2 style="font-size:clamp(26px,3.6vw,44px);margin:12px 0 0">{c.journeysH}</h2>
      </div>
    </div>
    {journeys.map((e, i) => (
      <a href={'/' + e.data.urlPath} style={`display:grid;grid-template-columns:88px 1fr 1fr 140px;gap:24px;align-items:center;padding:22px 24px;border-radius:var(--radius-lg);text-decoration:none;color:inherit;margin-top:${i ? '8px' : '0'};background:${i % 2 === 0 ? 'var(--color-neutral-100)' : 'transparent'}`}>
        <div class="ph" style="height:68px;border-radius:var(--radius-md)"></div>
        <h3 style="font-size:22px;margin:0">{e.data.title}</h3>
        <span style="font-size:14px;color:var(--color-neutral-700)">{e.data.tourType}{e.data.duration ? ' · ' + e.data.duration : ''}</span>
        {e.data.price ? <span class="tag tag-accent" style="justify-self:end">{c.from} €{e.data.price.toLocaleString('en-US')}</span> : <span />}
      </a>
    ))}
  </section>
)}

<section style="padding:0 40px 88px">
  <div style="margin-bottom:28px">
    <span class="mono" style="color:var(--color-accent-700)">{c.destEye}</span>
    <h2 style="font-size:clamp(26px,3.6vw,44px);margin:12px 0 0">{c.destH}</h2>
  </div>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:16px">
    {dests.map((n) => (
      <a href={b + '/tours'} style="display:block;text-decoration:none;color:inherit">
        <div class="ph" style="height:150px;border-radius:var(--radius-md)"><span>photo — {n}</span></div>
        <p style="font-family:var(--font-heading);font-weight:var(--font-heading-weight, 400);font-size:16px;margin:10px 0 0;color:var(--color-text)">{n}</p>
      </a>
    ))}
  </div>
</section>

<section style="padding:0 40px 88px">
  <div style="background:var(--color-accent-2-900);color:var(--color-neutral-100);border-radius:var(--radius-lg);padding:56px 40px">
    <div style="text-align:center;max-width:640px;margin:0 auto 44px">
      <span class="mono" style="color:var(--color-accent-400)">{c.whyEye}</span>
      <h2 style="font-size:clamp(26px,3.6vw,40px);margin:12px 0 0;color:#fff">{c.whyH}</h2>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:32px">
      {c.feats.map((ft: string[]) => (
        <div>
          <h3 style="font-size:18px;margin:0 0 8px;color:#fff">{ft[0]}</h3>
          <p style="font-size:14px;line-height:1.6;color:var(--color-neutral-300);margin:0">{ft[1]}</p>
        </div>
      ))}
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:32px;margin-top:48px;padding-top:44px;border-top:1px solid rgba(255,255,255,.14)">
      {stats.map(([n, d]) => (
        <div>
          <span style="font-family:var(--font-heading);font-weight:700;font-size:44px;color:var(--color-accent-400);display:block;line-height:1">{n}</span>
          <p style="font-size:13px;line-height:1.5;color:var(--color-neutral-300);margin:10px 0 0">{d}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section style="padding:0 40px 88px">
  <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:32px;margin-bottom:24px;flex-wrap:wrap">
    <div>
      <span class="mono" style="color:var(--color-accent-700)">{c.revEye}</span>
      <h2 style="font-size:clamp(26px,3.6vw,40px);margin:12px 0 0">{c.revH}</h2>
      <p style="font-size:15px;color:var(--color-neutral-700);margin:8px 0 0">{c.revP}</p>
    </div>
    <a href={b + '/reviews'} style="font-size:15px;font-weight:600">{c.readReviews}</a>
  </div>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px">
    {reviews.map((r) => (
      <article style="border:1px solid var(--color-divider);border-radius:var(--radius-lg);padding:22px;display:flex;flex-direction:column;gap:10px">
        <div style="color:var(--color-accent);font-size:14px">★★★★★</div>
        <p style="font-size:15px;line-height:1.6;color:var(--color-neutral-800);margin:0">&ldquo;{r.text}&rdquo;</p>
        <div style="display:flex;align-items:center;gap:10px;margin-top:auto;padding-top:12px;border-top:1px solid var(--color-divider)">
          <div style="width:34px;height:34px;border-radius:999px;flex:none;background:var(--color-accent-200);color:var(--color-accent-800);display:grid;place-items:center;font-weight:700;font-family:var(--font-heading)">{r.name[0]}</div>
          <div><p style="font-size:14px;font-weight:600;margin:0">{r.name}</p><p style="font-size:12px;color:var(--color-neutral-600);margin:0">{r.place}</p></div>
        </div>
      </article>
    ))}
  </div>
</section>

<section style="padding:0 40px 88px">
  <div style="border:1px solid var(--color-divider);border-radius:var(--radius-lg);padding:56px 40px;text-align:center">
    <span class="mono" style="color:var(--color-accent-700)">{c.ctaEye}</span>
    <h2 style="font-size:clamp(26px,3.6vw,40px);margin:12px 0 14px">{c.ctaH}</h2>
    <p style="font-size:16px;line-height:1.6;color:var(--color-neutral-700);max-width:480px;margin:0 auto 28px">{c.ctaP}</p>
    <a href={b + '/tours'} class="btn btn-primary" style="font-size:16px;padding:14px 30px">{c.ctaBtn}</a>
  </div>
</section>
