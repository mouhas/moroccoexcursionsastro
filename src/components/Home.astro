---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import TourCard from './TourCard.astro';
import { base, UI, type Lang } from '../site';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const b = base(lang);
const t = UI[lang];

const COPY: Record<Lang, any> = {
  en: {
    badge: 'Local & Independent Since 2008',
    h1: 'Morocco Tours Tailored to You',
    lead: 'We specialize in bespoke Morocco tours, available year-round, with flexible start dates from Marrakech, Casablanca, Fes and Merzouga — from single-day excursions to month-long adventures, private or in a group.',
    explore: 'Explore Tours', custom: 'Plan a Custom Trip',
    popEye: 'Handpicked journeys', popH: 'Popular Tours & Excursions',
    popP: 'From sunrise camel treks to grand cross-country adventures — every trip is private, flexible, and fully customisable.',
    whyEye: 'Why travel with us', whyH: 'Why Morocco Excursions?',
    whyP: 'Our team is made up of professional local experts who create tours across Morocco — cultural and historical trips to UNESCO heritage sites, plus adventure activities like 4WD off-road trips, Saharan expeditions and camel treks.',
    feats: [['100% Local & Independent','Created and owned by Berber experts — local families from Morocco’s southern desert.'],['Fully Customisable','Tours from 1 to 30 days, private or in a group, tailored to exactly what you want.'],['Trusted Since 2008','Creating unique Morocco travel experiences for over 15 years, with a focus on sustainable, local tourism.'],['We Speak Your Language','English, Français, Español, Italiano & Português — plus 24/7 support.']],
    destEye: 'Where to go', destH: 'Explore by Destination',
    revEye: 'Loved by travellers', revH: 'What Our Guests Say', revP: 'Real feedback from recent Morocco Excursions guests.',
    quotes: [
      {text: 'Our tour guide Ali was so kind, and I can’t say enough good things about him and his knowledge about Morocco.', name: 'Nora L.', place: 'United States'},
      {text: 'It was one of my most memorable vacations, and I would highly recommend this agency to everyone.', name: 'Michael T.', place: 'United Kingdom'},
      {text: 'Ali was gentle, patient, and flexible. Thank you Morocco Excursions for this amazing Morocco tour.', name: 'Olivier P.', place: 'Australia'},
    ],
    ctaH: 'Ready to Experience the Real Morocco?', ctaP: 'Tell us your dates and dreams — our local team will craft a private itinerary just for you, with no pressure and no hidden fees.',
    ctaBtn: 'Browse Tours',
  },
  fr: {
    badge: 'Locale et indépendante depuis 2008',
    h1: 'Circuits au Maroc sur mesure',
    lead: 'Nous proposons des circuits au Maroc personnalisés tout au long de l’année, au départ de Marrakech, Casablanca, Fès et Merzouga — de l’excursion d’une journée aux grands voyages d’un mois, en privé ou en groupe.',
    explore: 'Voir les circuits', custom: 'Circuit sur mesure',
    popEye: 'Voyages sélectionnés', popH: 'Circuits & Excursions populaires',
    popP: 'Des randonnées à dos de chameau au lever du soleil aux grands périples — chaque voyage est privé, flexible et entièrement personnalisable.',
    whyEye: 'Pourquoi nous choisir', whyH: 'Qui Sommes-Nous ?',
    whyP: 'Chez Morocco Excursions, nous proposons des circuits de luxe VIP ainsi que des forfaits tout compris pour les groupes et les particuliers : activités historiques, culturelles et d’aventure comme les 4x4, les expéditions dans le Sahara et les randonnées à dos de chameau.',
    feats: [['100 % local & indépendant','Créée et détenue à 100 % par des experts berbères — familles locales du désert du sud marocain.'],['Entièrement personnalisable','Circuits de 1 à 30 jours, privés ou en groupe, adaptés à vos envies.'],['De confiance depuis 2008','Des voyages uniques au Maroc depuis plus de 15 ans, avec une attention portée au tourisme durable et local.'],['Nous parlons votre langue','Anglais, Français, Espagnol, Italien & Portugais — assistance 24/7.']],
    destEye: 'Où aller', destH: 'Explorer par destination',
    revEye: 'Adoré des voyageurs', revH: 'Ce Que Disent Nos Clients', revP: 'De vrais avis de récents clients de Morocco Excursions.',
    quotes: [
      {text: 'Notre guide Ali était si gentil, et je ne peux pas dire assez de bien de lui et de ses connaissances sur le Maroc.', name: 'Josephine O.', place: 'Canada'},
      {text: 'Ce fut l’une de mes vacances les plus mémorables, et je recommanderais vivement cette agence à tout le monde.', name: 'Gabriel Y.', place: 'France'},
      {text: 'Ali était doux, patient et flexible. Merci à Morocco Excursions pour cet incroyable voyage au Maroc.', name: 'Jules B.', place: 'France'},
    ],
    ctaH: 'Prêt à vivre le vrai Maroc ?', ctaP: 'Dites-nous vos dates et vos envies — notre équipe locale créera un itinéraire privé rien que pour vous, sans pression ni frais cachés.',
    ctaBtn: 'Voir les circuits',
  },
  es: {
    badge: 'Local e independiente desde 2008',
    h1: 'Viajes a Marruecos a tu medida',
    lead: 'Ofrecemos viajes personalizados a Marruecos durante todo el año, con salidas flexibles desde Marrakech, Casablanca, Fez y Merzouga — desde excursiones de un día hasta aventuras de un mes, privadas o en grupo.',
    explore: 'Ver tours', custom: 'Viaje personalizado',
    popEye: 'Viajes seleccionados', popH: 'Tours y Excursiones populares',
    popP: 'Desde paseos en camello al amanecer hasta grandes aventuras — cada viaje es privado, flexible y totalmente personalizable.',
    whyEye: 'Por qué elegirnos', whyH: '¿Quiénes Somos?',
    whyP: 'En Morocco Excursions ofrecemos viajes de lujo VIP y paquetes todo incluido para grupos y particulares: actividades históricas, culturales y de aventura como los todoterreno 4x4, expediciones al Sahara y paseos en camello.',
    feats: [['100% local e independiente','Creada y propiedad de expertos bereberes — familias locales del desierto del sur de Marruecos.'],['Totalmente personalizable','Viajes de 1 a 30 días, privados o en grupo, adaptados a lo que buscas.'],['De confianza desde 2008','Creando viajes únicos a Marruecos desde hace más de 15 años, con enfoque en el turismo sostenible y local.'],['Hablamos tu idioma','Inglés, Francés, Español, Italiano y Portugués — soporte 24/7.']],
    destEye: 'A dónde ir', destH: 'Explorar por destino',
    revEye: 'Amado por viajeros', revH: 'Lo Que Dicen Nuestros Clientes', revP: 'Opiniones reales de clientes recientes de Morocco Excursions.',
    quotes: [
      {text: 'Nuestro guía turístico, Ali, fue muy amable y no tengo palabras para describirlo y sus conocimientos sobre Marruecos.', name: 'Fernanda P.', place: 'Argentina'},
      {text: 'Fueron unas de mis vacaciones más memorables y recomendaría esta agencia a todo el mundo.', name: 'Miguel O.', place: 'España'},
      {text: 'Ali fue amable, paciente y flexible. Gracias a Morocco Excursions por este increíble tour por Marruecos.', name: 'Oscar L.', place: 'Colombia'},
    ],
    ctaH: '¿Listo para vivir el verdadero Marruecos?', ctaP: 'Cuéntanos tus fechas y sueños — nuestro equipo local creará un itinerario privado solo para ti, sin presión ni costes ocultos.',
    ctaBtn: 'Ver tours',
  },
  it: {
    badge: 'Locale e indipendente dal 2008',
    h1: 'Tour in Marocco su misura',
    lead: 'Offriamo tour personalizzati in Marocco tutto l’anno, con partenza in qualsiasi momento da Marrakech, Casablanca, Fes e Merzouga — da escursioni di un giorno a viaggi di un mese, privati o di gruppo.',
    explore: 'Scopri i tour', custom: 'Viaggio su misura',
    popEye: 'Viaggi selezionati', popH: 'Tour ed Escursioni popolari',
    popP: 'Dalle escursioni in cammello all’alba ai grandi viaggi — ogni tour è privato, flessibile e personalizzabile.',
    whyEye: 'Perché sceglierci', whyH: 'Chi Siamo?',
    whyP: 'Da Morocco Excursions offriamo tour VIP di lusso e pacchetti all-inclusive per gruppi e privati: attività storiche, culturali e avventurose come fuoristrada 4x4, spedizioni nel Sahara e trekking in cammello.',
    feats: [['100% locale e indipendente','Creata e posseduta da esperti berberi — famiglie locali del deserto a sud del Marocco.'],['Totalmente personalizzabile','Tour da 1 a 30 giorni, privati o di gruppo, su misura per te.'],['Affidabili dal 2008','Viaggi unici in Marocco da oltre 15 anni, con attenzione al turismo sostenibile e locale.'],['Parliamo la tua lingua','Inglese, Francese, Spagnolo, Italiano e Portoghese — supporto 24/7.']],
    destEye: 'Dove andare', destH: 'Esplora per destinazione',
    revEye: 'Amato dai viaggiatori', revH: 'Cosa Dicono I Nostri Clienti', revP: 'Recensioni reali di clienti recenti di Morocco Excursions.',
    quotes: [
      {text: 'La nostra guida turistica Ali è stata così gentile e non posso dire abbastanza cose positive su di lui e sulla sua conoscenza del Marocco.', name: 'Laura N.', place: ''},
      {text: 'È stata una delle mie vacanze più memorabili e consiglierei vivamente questa agenzia a tutti.', name: 'Marco C.', place: ''},
      {text: 'Ali è stato gentile, paziente e flessibile. Grazie Morocco Excursions per questo fantastico tour in Marocco.', name: 'Giaco K.', place: ''},
    ],
    ctaH: 'Pronto a vivere il vero Marocco?', ctaP: 'Dicci le tue date e i tuoi sogni — il nostro team locale creerà un itinerario privato solo per te, senza pressioni né costi nascosti.',
    ctaBtn: 'Scopri i tour',
  },
  'pt-br': {
    badge: 'Local e independente desde 2008',
    h1: 'Passeios em Marrocos sob medida',
    lead: 'Oferecemos passeios personalizados em Marrocos durante todo o ano, com saídas flexíveis de Marrakech, Casablanca, Fez e Merzouga — de excursões de um dia a viagens de um mês, privadas ou em grupo.',
    explore: 'Ver tours', custom: 'Viagem personalizada',
    popEye: 'Viagens selecionadas', popH: 'Tours e Excursões populares',
    popP: 'De passeios de camelo ao amanhecer a grandes aventuras — cada viagem é privada, flexível e totalmente personalizável.',
    whyEye: 'Por que viajar conosco', whyH: 'Nossa Equipe',
    whyP: 'Na Morocco Excursions oferecemos passeios VIP de luxo e pacotes com tudo incluído para grupos e privados: atividades históricas, culturais e de aventura como aventuras off-road em 4x4, expedições no Saara e passeios de camelo.',
    feats: [['100% local e independente','Criada e administrada por especialistas berberes — famílias locais do deserto ao sul do Marrocos.'],['Totalmente personalizável','Passeios de 1 a 30 dias, privados ou em grupo, sob medida para você.'],['De confiança desde 2008','Criando viagens únicas pelo Marrocos há mais de 15 anos, com foco em turismo sustentável e local.'],['Falamos o seu idioma','Inglês, Francês, Espanhol, Italiano e Português — suporte 24/7.']],
    destEye: 'Para onde ir', destH: 'Explore por destino',
    revEye: 'Amado pelos viajantes', revH: 'O Que Nossos Clientes Dizem', revP: 'Avaliações reais de clientes recentes da Morocco Excursions.',
    quotes: [
      {text: 'Nosso guia turístico Ali foi muito gentil, e não posso dizer coisas boas o suficiente sobre ele e seu conhecimento sobre o Marrocos.', name: 'Elena', place: 'Brasil'},
      {text: 'Foi uma das minhas férias mais memoráveis, e eu recomendo fortemente esta agência a todos.', name: 'Mauro J.', place: 'Portugal'},
      {text: 'Ali foi gentil, paciente e flexível. Obrigado Morocco Excursions por este tour incrível no Marrocos.', name: 'Bernardo K.', place: 'Brasil'},
    ],
    ctaH: 'Pronto para viver o verdadeiro Marrocos?', ctaP: 'Conte-nos suas datas e sonhos — nossa equipe local criará um roteiro privado só para você, sem pressão nem custos ocultos.',
    ctaBtn: 'Ver tours',
  },
};
const c = COPY[lang];

// Featured tours from this language's content, spread across the price range for variety.
const all = await getCollection('site', (e) => e.data.lang === lang && e.data.section === 'tours' && e.data.price);
all.sort((a, z) => (z.data.price ?? 0) - (a.data.price ?? 0));
const pick: typeof all = [];
if (all.length) {
  const step = Math.max(1, Math.floor(all.length / 6));
  for (let i = 0; i < all.length && pick.length < 6; i += step) pick.push(all[i]);
  let i = 0;
  while (pick.length < 6 && i < all.length) { if (!pick.includes(all[i])) pick.push(all[i]); i++; }
}
const tags = ['Bestseller','Grand Tour','Popular','Adventure','Culture','Romantic'];
const dests = [
  {n:'Merzouga & the Sahara', big:true}, {n:'Marrakech'}, {n:'Fes'},
  {n:'Chefchaouen', tall:true}, {n:'Ouarzazate'}, {n:'Essaouira'},
];
const featIcons = ['tent','compass','star','chat'];
---
<!-- HERO -->
<section class="home-hero">
  <div class="home-hero-bg">
    <svg viewBox="0 0 1440 640" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="hsky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#1a78c9"/><stop offset="0.55" stop-color="#3a93d8"/><stop offset="1" stop-color="#bfe0f2"/></linearGradient>
        <linearGradient id="hd1" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f9a24d"/><stop offset="1" stop-color="#ef7f22"/></linearGradient>
        <linearGradient id="hd2" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ec7a1e"/><stop offset="1" stop-color="#cf5f10"/></linearGradient>
        <linearGradient id="hd3" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#c85c14"/><stop offset="1" stop-color="#9c440b"/></linearGradient>
      </defs>
      <rect width="1440" height="640" fill="url(#hsky)"/>
      <circle cx="1090" cy="165" r="66" fill="#fff3d6" opacity="0.95"/>
      <path d="M0 380 C 300 300 520 420 780 360 C 1040 300 1240 380 1440 340 L1440 640 L0 640 Z" fill="url(#hd1)"/>
      <path d="M0 470 C 260 400 480 500 760 460 C 1060 415 1260 490 1440 450 L1440 640 L0 640 Z" fill="url(#hd2)"/>
      <path d="M0 560 C 320 510 560 580 860 545 C 1120 515 1300 575 1440 555 L1440 640 L0 640 Z" fill="url(#hd3)"/>
    </svg>
  </div>
  <div class="wrap home-hero-in">
    <div class="rbadge"><span class="stars"><Icon name="star"/><Icon name="star"/><Icon name="star"/><Icon name="star"/><Icon name="star"/></span> {c.badge}</div>
    <h1>{c.h1}</h1>
    <p class="lead">{c.lead}</p>
    <div class="hcta">
      <a href={b + '/tours'} class="btn">{c.explore}</a>
      <a href={b + '/tours'} class="btn ghost">{c.custom}</a>
    </div>
  </div>
</section>

<!-- TRUST -->
<div class="trust">
  <div class="wrap">
    <div class="ti"><span class="tiw"><Icon name="star"/></span><span class="tx"><b>820+</b><small>5-star reviews</small></span></div>
    <div class="ti"><span class="tiw"><Icon name="pin"/></span><span class="tx"><b>100%</b><small>Local Berber team</small></span></div>
    <div class="ti"><span class="tiw"><Icon name="map"/></span><span class="tx"><b>145+</b><small>Tours & excursions</small></span></div>
    <div class="ti"><span class="tiw"><Icon name="globe"/></span><span class="tx"><b>5</b><small>Languages</small></span></div>
    <div class="ti"><span class="tiw"><Icon name="clock"/></span><span class="tx"><b>24/7</b><small>Trip support</small></span></div>
  </div>
</div>

<!-- FEATURED TOURS -->
<section class="pad">
  <div class="wrap">
    <div class="sec-head"><div class="eyebrow">{c.popEye}</div><h2>{c.popH}</h2><p>{c.popP}</p></div>
    <div class="grid">
      {pick.map((e, i) => (
        <TourCard href={'/' + e.data.urlPath} title={e.data.title} price={e.data.price}
          duration={e.data.duration} tag={tags[i % tags.length]} lang={lang} seed={e.data.pslug} urlPath={e.data.urlPath}
          rating={e.data.rating} reviewCount={e.data.reviewCount} />
      ))}
    </div>
    <div class="center"><a href={b + '/tours'} class="btn blue">{t.viewAll} →</a></div>
  </div>
</section>

<!-- WHY US -->
<section class="pad soft">
  <div class="wrap">
    <div class="sec-head"><div class="eyebrow">{c.whyEye}</div><h2>{c.whyH}</h2><p>{c.whyP}</p></div>
    <div class="grid4">
      {c.feats.map((ft: string[], i: number) => (
        <div class="feature"><div class="fiw"><Icon name={featIcons[i]} /></div><h3>{ft[0]}</h3><p>{ft[1]}</p></div>
      ))}
    </div>
  </div>
</section>

<!-- DESTINATIONS -->
<section class="pad">
  <div class="wrap">
    <div class="sec-head"><div class="eyebrow">{c.destEye}</div><h2>{c.destH}</h2></div>
    <div class="dest-grid">
      {dests.map((d) => (
        <a href={b + '/tours'} class={'dest' + (d.big ? ' big' : '') + (d.tall ? ' tall' : '')}>
          <svg preserveAspectRatio="xMidYMid slice" viewBox="0 0 300 240"><rect width="300" height="240" fill="#3a93d8"/><circle cx="230" cy="55" r="30" fill="#fff3d6"/><path d="M0 150 C90 110 200 180 300 140 L300 240 L0 240Z" fill="#ef7f22"/><path d="M0 190 C110 160 210 200 300 178 L300 240 L0 240Z" fill="#cf5f10"/></svg>
          <span>{d.n}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- REVIEWS -->
<section class="pad soft">
  <div class="wrap">
    <div class="sec-head"><div class="eyebrow">{c.revEye}</div><h2>{c.revH}</h2><p>{c.revP}</p></div>
    <div class="grid">
      {c.quotes.map((q: {text: string; name: string; place: string}) => (
        <div class="quote"><div class="stars"><Icon name="star"/><Icon name="star"/><Icon name="star"/><Icon name="star"/><Icon name="star"/></div><p>"{q.text}"</p><div class="who"><span class="av">{q.name[0]}</span><span><b>{q.name}</b><small>{q.place}</small></span></div></div>
      ))}
    </div>
    <div class="center"><a href={b + '/reviews'} class="btn">{t.readReviews} →</a></div>
  </div>
</section>

<!-- CTA -->
<section class="home-cta">
  <svg class="bg" preserveAspectRatio="xMidYMid slice" viewBox="0 0 1440 380"><rect width="1440" height="380" fill="#1a78c9"/><circle cx="1160" cy="100" r="44" fill="#fff3d6" opacity=".95"/><path d="M0 230 C300 175 560 270 860 225 C1120 185 1300 245 1440 215 L1440 380 L0 380Z" fill="#ef7f22"/><path d="M0 290 C320 245 600 310 900 280 C1160 250 1320 300 1440 285 L1440 380 L0 380Z" fill="#cf5f10"/></svg>
  <div class="wrap">
    <h2>{c.ctaH}</h2>
    <p>{c.ctaP}</p>
    <a href={b + '/tours'} class="btn">{c.ctaBtn}</a>
  </div>
</section>

<style>
  .home-hero{position:relative;min-height:600px;display:flex;align-items:center;color:#fff;overflow:hidden}
  .home-hero-bg{position:absolute;inset:0;z-index:0}
  .home-hero-bg svg{width:100%;height:100%}
  .home-hero::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(10,30,55,.72),rgba(10,30,55,.28));z-index:1}
  .home-hero-in{position:relative;z-index:2;padding:70px 22px}
  .home-hero h1{font-size:clamp(32px,5.2vw,58px);max-width:17ch;text-shadow:0 2px 20px rgba(0,0,0,.3)}
  .home-hero .lead{font-size:clamp(16px,2vw,20px);max-width:54ch;margin:20px 0 30px;opacity:.95}
  .hcta{display:flex;gap:14px;flex-wrap:wrap}
  .rbadge{display:inline-flex;align-items:center;gap:9px;background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.3);padding:8px 15px;border-radius:40px;font-size:14px;margin-bottom:22px}
  .trust{background:var(--blue-dk);color:#fff}
  .trust .wrap{display:flex;justify-content:space-around;gap:18px;padding:22px;flex-wrap:wrap}
  .ti{display:flex;align-items:center;gap:12px}
  .tiw{width:44px;height:44px;border-radius:12px;background:rgba(255,255,255,.12);display:grid;place-items:center;color:var(--orange)}
  .ti b{font-family:"Open Sans",sans-serif;font-size:23px;display:block;line-height:1}
  .ti small{font-size:12.5px;opacity:.85}
  .soft{background:var(--blue-lt)}
  .grid4{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:28px}
  .feature{text-align:center;padding:10px}
  .fiw{width:66px;height:66px;margin:0 auto 16px;border-radius:18px;background:#fff;display:grid;place-items:center;box-shadow:var(--shadow);color:var(--orange)}
  .fiw :global(svg){width:28px;height:28px}
  .feature h3{font-size:19px;margin-bottom:8px}
  .feature p{font-size:14.5px;color:var(--muted)}
  .dest-grid{display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:160px;gap:16px}
  .dest{position:relative;border-radius:14px;overflow:hidden;color:#fff;display:flex;align-items:flex-end;padding:16px;font-weight:700;font-family:"Open Sans",sans-serif;font-size:19px;box-shadow:var(--shadow)}
  .dest svg{position:absolute;inset:0;width:100%;height:100%;z-index:0}
  .dest::after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,rgba(8,20,35,.72),transparent 60%);z-index:1}
  .dest span{position:relative;z-index:2}
  .dest.big{grid-column:span 2;grid-row:span 2}
  .dest.tall{grid-row:span 2}
  .quote{background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:26px;box-shadow:var(--shadow)}
  .quote .stars{margin-bottom:12px}
  .quote .stars :global(svg){width:17px;height:17px}
  .quote p{font-size:15px;color:#3a4756}
  .quote .who{display:flex;align-items:center;gap:12px;margin-top:18px}
  .quote .av{width:42px;height:42px;border-radius:50%;background:linear-gradient(135deg,var(--orange),var(--blue-2));color:#fff;display:grid;place-items:center;font-weight:700;font-family:Roboto,sans-serif}
  .quote .who b{font-size:14px;display:block}.quote .who small{color:var(--muted);font-size:12.5px}
  .home-cta{position:relative;color:#fff;text-align:center;overflow:hidden}
  .home-cta .bg{position:absolute;inset:0;width:100%;height:100%;z-index:0}
  .home-cta::after{content:"";position:absolute;inset:0;background:linear-gradient(rgba(10,28,50,.72),rgba(10,28,50,.55));z-index:1}
  .home-cta .wrap{position:relative;z-index:2;padding:76px 22px}
  .home-cta h2{font-size:clamp(28px,4vw,44px);color:#fff}
  .home-cta p{max-width:52ch;margin:14px auto 26px;font-size:17px;opacity:.94}
  @media(max-width:900px){.dest-grid{grid-template-columns:1fr 1fr}.dest.big{grid-column:span 2}}
  @media(max-width:680px){.home-hero{min-height:540px}.dest-grid{grid-template-columns:1fr}.dest.big{grid-column:span 1}}
</style>
