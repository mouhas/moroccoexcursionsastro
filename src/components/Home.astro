---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import { base, UI, GENERAL_REVIEWS, type Lang } from '../site';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const b = base(lang);
const t = UI[lang];

const COPY: Record<Lang, any> = {
  en: {
    eyebrowHero: 'Small-group journeys across Morocco',
    h1: 'The desert, the medina, and everything between',
    lead: 'A 100% local, Berber-owned team running private and small-group tours since 2008 — from single-day excursions to month-long adventures, tailored around you.',
    explore: 'Explore Tours', custom: 'Plan a Custom Trip',
    searchTitle: 'Find your trip',
    destLabel: 'Destination', typeLabel: 'Trip type', durLabel: 'Duration', travLabel: 'Travellers', search: 'Search',
    destOpts: ['All of Morocco', 'Marrakech & the Atlas', 'Fès & Imperial cities', 'Sahara & Merzouga', 'Essaouira & the Coast', 'Chefchaouen & the Rif'],
    typeOpts: ['Any type', 'Multi-day tour', 'Day trip', 'Desert camp', 'Car rental', 'Tailor-made'],
    durOpts: ['Any length', '1 day', '2–4 days', '5–7 days', '8+ days'],
    travOpts: ['2 travellers', '1 traveller', '3–4 travellers', '5+ / private group'],
    popEye: 'Handpicked journeys', popH: 'Popular tours & excursions',
    popP: 'Every departure is private, flexible and guided by a local — filter the full list to find yours.',
    journeysEye: 'Featured journeys', journeysH: 'More ways to see Morocco',
    destEye: 'Where to go', destH: 'Explore by destination',
    whyEye: 'Why travel with us', whyH: 'Why Morocco Excursions?',
    feats: [['100% Local & Independent', 'Created and owned by Berber experts — local families from Morocco’s southern desert.'], ['Fully Customisable', 'Tours from 1 to 30 days, private or in a group, tailored to exactly what you want.'], ['Trusted Since 2008', 'Creating unique Morocco travel experiences for over 15 years, with a focus on sustainable, local tourism.'], ['We Speak Your Language', 'English, Français, Español, Italiano & Português — plus 24/7 support.']],
    revEye: 'Loved by travellers', revH: 'What our guests say', revP: 'Real feedback from recent Morocco Excursions guests.',
    ctaEye: 'Ready when you are', ctaH: 'Tell us your dates and dreams', ctaP: 'Our local team will craft a private itinerary just for you — no pressure and no hidden fees.',
    ctaBtn: 'Browse tours', readReviews: 'Read all reviews →',
    perPerson: 'pp', from: 'from', notRated: 'Not yet rated',
  },
  fr: {
    eyebrowHero: 'Voyages en petit groupe à travers le Maroc',
    h1: 'Le désert, la médina, et tout ce qu’il y a entre les deux',
    lead: 'Une équipe 100 % locale, détenue par des Berbères, organisant des circuits privés et en petit groupe depuis 2008 — de l’excursion d’une journée aux grands voyages d’un mois, sur mesure.',
