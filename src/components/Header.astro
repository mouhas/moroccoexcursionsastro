---
// Shared header, used on every page including individual tour detail
// pages. Rendered by Base.astro inside a .newtheme wrapper so the real
// Organic classes/tokens apply.
import Icon from './Icon.astro';
import { getNav, homeHref, langSwitchHref, LANGS, LANG_LABELS, UI, type Lang } from '../site';
interface Props {
  lang: Lang;
  section?: 'home' | 'pages' | 'tours' | 'cars';
  pslug?: string;
}
const { lang, section = 'home', pslug } = Astro.props;
const nav = getNav(lang);
const t = UI[lang];
const CURRENCIES: { code: string; label: string }[] = [
  { code: 'EUR', label: '€ Euro' },
  { code: 'USD', label: '$ US Dollar' },
  { code: 'GBP', label: '£ British Pound' },
  { code: 'MAD', label: 'DH Moroccan Dirham' },
];
---
<header class="newtheme site-header" style="position:sticky;top:0;z-index:50;display:flex;align-items:center;justify-content:space-between;gap:24px;padding:14px max(40px, calc((100% - 1180px) / 2));background:var(--color-accent-700);color:#fff;border-bottom:1px solid var(--color-accent-800)">
  <a href={homeHref(lang)} class="btn btn-ghost" style="gap:10px;font-size:20px;letter-spacing:-0.03em;color:#fff;flex:none">
    <span style="width:26px;height:26px;border-radius:10px;background:#fff;display:inline-block"></span>
    Morocco Excursions
  </a>

  <div class="nav-wrap" id="navWrap">
    <nav class="main-nav" id="mainNav">
      {nav.map((n) => (
        <a href={n.href} class="btn btn-ghost nav-link" style="color:#fff">
          <Icon name={n.icon} class="ico sm" />
          <span>{n.label}</span>
        </a>
      ))}
    </nav>
    <div class="util-cluster">
      <div class="util-item" id="langSwitcher">
        <button type="button" id="langToggle" aria-expanded="false" aria-haspopup="true" class="util-btn">
          <Icon name="globe" class="ico sm" />
          <span>{LANG_LABELS[lang]}</span>
          <Icon name="chevron" class="ico xs chevron" />
        </button>
        <div class="menu-panel" id="langMenu" role="menu">
          {LANGS.map((l) => (
            <a href={langSwitchHref(l, { section, pslug, lang })} class="menu-row" role="menuitem" aria-current={l === lang ? 'true' : undefined}>
              <span>{LANG_LABELS[l]}</span>
              <Icon name="check" class="ico xs" />
            </a>
          ))}
        </div>
      </div>
      <div class="util-item" id="curSwitcher">
        <button type="button" id="curToggle" aria-expanded="false" aria-haspopup="true" class="util-btn" title="Reference currency — bookings are charged in EUR">
          <Icon name="coin" class="ico sm" />
          <span id="curLabel">EUR</span>
          <Icon name="chevron" class="ico xs chevron" />
        </button>
        <div class="menu-panel" id="curMenu" role="menu">
          {CURRENCIES.map((c) => (
            <button type="button" class="menu-row cur-opt" data-code={c.code} role="menuitem" aria-current={c.code === 'EUR' ? 'true' : undefined}>
              <span>{c.label}</span>
              <Icon name="check" class="ico xs" />
            </button>
          ))}
        </div>
      </div>
      <button type="button" class="theme-toggle" id="themeToggle" aria-label="Toggle dark mode">
        <Icon name="sun" class="ico sm icon-sun" />
        <Icon name="moon" class="ico sm icon-moon" />
      </button>
    </div>
  </div>

  <div style="display:flex;align-items:center;gap:10px;flex:none">
    <a href={nav[0]?.href ?? homeHref(lang)} class="btn" style="border-radius:10px;padding:11px 22px;background:#fff;color:var(--color-accent-800);font-weight:600">{t.book}</a>
    <button class="burger" aria-label="Menu" id="burger"><span></span><span></span><span></span></button>
  </div>
</header>

<style>
  .main-nav { display: flex; align-items: center; gap: 2px; }
  .main-nav .nav-link { font-size: 16px; font-weight: 600; padding: 10px 15px; white-space: nowrap; }
  .main-nav .nav-link :global(.ico) { opacity: 0.85; }
  .nav-wrap { display: flex; align-items: center; gap: 26px; flex: 1; justify-content: center; }
  .util-cluster { display: flex; align-items: center; gap: 8px; padding-left: 12px; border-left: 1px solid rgba(255, 255, 255, 0.25); }
  .util-item { position: relative; }
  /* :global() below is required, not stylistic — Icon.astro renders its own
     <svg>, which is a different component's output and never receives this
     file's data-astro-cid scope attribute. Without :global(), every rule
     that needs to reach an icon (sizing, opacity toggles, transforms) would
     silently no-op: the selector compiles fine but matches nothing. */
  :global(.ico.xs) { width: 13px; height: 13px; }

  .util-btn {
    display: inline-flex; align-items: center; gap: 6px; background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.3); color: #fff; font: inherit; font-size: 13.5px;
    font-weight: 600; cursor: pointer; padding: 7px 12px; border-radius: 20px; transition: background 0.15s;
  }
  .util-btn:hover { background: rgba(255, 255, 255, 0.22); }
  .util-btn :global(.chevron) { transition: transform 0.15s; opacity: 0.8; }
  .util-btn[aria-expanded='true'] :global(.chevron) { transform: rotate(180deg); }

  .menu-panel {
    position: absolute; top: calc(100% + 10px); right: 0; min-width: 210px;
    background: var(--color-surface); color: var(--color-text);
    border-radius: 14px; box-shadow: var(--shadow-lg); border: 1px solid var(--color-divider);
    padding: 8px; display: none; flex-direction: column; gap: 1px; z-index: 60;
  }
  .menu-panel.open { display: flex; }
  .menu-row {
    display: flex; align-items: center; justify-content: space-between; gap: 14px;
    padding: 9px 12px; border-radius: 9px; font-size: 14px; color: inherit;
    background: none; border: none; cursor: pointer; text-align: left; width: 100%; font-family: inherit;
  }
  .menu-row:hover { background: color-mix(in srgb, var(--color-accent) 10%, transparent); }
  .menu-row :global(.ico.xs) { color: var(--color-accent); opacity: 0; flex: none; }
  .menu-row[aria-current='true'] { font-weight: 700; color: var(--color-accent-700); }
  .menu-row[aria-current='true'] :global(.ico.xs) { opacity: 1; }

  .theme-toggle {
    position: relative; display: inline-flex; align-items: center; justify-content: center;
    width: 34px; height: 34px; border-radius: 50%; border: 1px solid rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.1); color: #fff; cursor: pointer; flex: none; transition: background 0.15s;
  }
  .theme-toggle:hover { background: rgba(255, 255, 255, 0.22); }
  .theme-toggle :global(.icon-sun), .theme-toggle :global(.icon-moon) {
    position: absolute; transition: opacity 0.25s ease, transform 0.35s ease;
  }
  .theme-toggle :global(.icon-sun) { opacity: 1; transform: rotate(0deg) scale(1); }
  .theme-toggle :global(.icon-moon) { opacity: 0; transform: rotate(90deg) scale(0.5); }
  :root[data-theme='dark'] .theme-toggle :global(.icon-sun) { opacity: 0; transform: rotate(-90deg) scale(0.5); }
  :root[data-theme='dark'] .theme-toggle :global(.icon-moon) { opacity: 1; transform: rotate(0deg) scale(1); }

  .burger { display: none; }

  @media (max-width: 1080px) {
    .nav-wrap {
      display: none;
      position: absolute; top: 100%; left: 0; right: 0;
      background: var(--color-accent-700); flex-direction: column; align-items: stretch;
      padding: 18px 22px 22px; gap: 16px; z-index: 40; border-bottom: 1px solid var(--color-accent-800);
    }
    .nav-wrap.open { display: flex; }
    .main-nav { flex-direction: column; align-items: stretch; gap: 2px; }
    .main-nav .nav-link { padding: 12px 6px; }
    .util-cluster { border-left: none; border-top: 1px solid rgba(255, 255, 255, 0.25); padding: 14px 0 0; flex-wrap: wrap; }
    .menu-panel { right: auto; left: 0; }
    .burger { display: flex; flex-direction: column; gap: 5px; background: none; border: none; cursor: pointer; padding: 6px; }
    .burger span { width: 24px; height: 2.5px; background: #fff; border-radius: 2px; display: block; }
  }
</style>

<script>
  const burger = document.getElementById('burger');
  const navWrap = document.getElementById('navWrap');
  burger?.addEventListener('click', () => {
    navWrap?.classList.toggle('open');
  });

  // Click-to-toggle only (no hover-open): a currency or language pick is a
  // deliberate action, not something that should fire on an accidental
  // mouse-over, and mixing hover-open with click-toggle is ambiguous the
  // moment a mouse hovers the button and then clicks it (the click would
  // immediately re-close what the hover just opened). Closes on an outside
  // click or Escape; shared by the language and currency dropdowns.
  function setupDropdown(switcherId: string, toggleId: string, menuId: string) {
    const switcher = document.getElementById(switcherId);
    const toggle = document.getElementById(toggleId);
    const menu = document.getElementById(menuId);
    function open() {
      menu?.classList.add('open');
      toggle?.setAttribute('aria-expanded', 'true');
    }
    function close() {
      menu?.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
    }
    toggle?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (menu?.classList.contains('open')) close();
      else open();
    });
    document.addEventListener('click', (e) => {
      if (switcher && !switcher.contains(e.target as Node)) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
    return { open, close };
  }
  setupDropdown('langSwitcher', 'langToggle', 'langMenu');
  const curDropdown = setupDropdown('curSwitcher', 'curToggle', 'curMenu');

  // Dark mode toggle — the actual theme attribute is applied as early as
  // possible by a blocking script in Base.astro's <head> (avoids a flash of
  // the wrong theme); this just flips it on click and remembers the choice.
  const themeToggle = document.getElementById('themeToggle');
  themeToggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
  });

  // Currency display — the site is static (no backend), so there's no live
  // FX feed or server-side price rewrite. Instead we scan the rendered page
  // for "€NNN" / "NNN€" amounts once, tag each with its EUR value, and
  // re-render that tag's text client-side when the visitor picks a
  // different currency. Approximate fixed rates; bookings are still charged
  // in EUR regardless of what's displayed (see the currency button's tooltip).
  const RATES: Record<string, number> = { EUR: 1, USD: 1.08, GBP: 0.86, MAD: 10.85 };
  const SYMS: Record<string, string> = { EUR: '€', USD: '$', GBP: '£', MAD: 'DH' };
  function formatPrice(eur: number, cur: string): string {
    const val = eur * (RATES[cur] ?? 1);
    const rounded = Math.round(val);
    const num = rounded.toLocaleString('en-US');
    return cur === 'MAD' ? `${num} ${SYMS[cur]}` : `${SYMS[cur]}${num}`;
  }
  function tagPrices() {
    const priceRegex = /(\d[\d.,]*)\s?€(?!\w)|€\s?(\d[\d.,]*)/g;
    const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, {
      acceptNode(node: Node) {
        if (!node.nodeValue || !node.nodeValue.includes('€')) return NodeFilter.FILTER_REJECT;
        let p = node.parentElement;
        while (p) {
          if (p.tagName === 'SCRIPT' || p.tagName === 'STYLE' || p.classList?.contains('cvt-price')) return NodeFilter.FILTER_REJECT;
          p = p.parentElement;
        }
        return NodeFilter.FILTER_ACCEPT;
      },
    });
    const nodes: Text[] = [];
    let n: Node | null;
    while ((n = walker.nextNode())) nodes.push(n as Text);
    nodes.forEach((node) => {
      const text = node.nodeValue || '';
      priceRegex.lastIndex = 0;
      if (!priceRegex.test(text)) return;
      priceRegex.lastIndex = 0;
      const frag = document.createDocumentFragment();
      let last = 0;
      let m: RegExpExecArray | null;
      while ((m = priceRegex.exec(text))) {
        const raw = m[1] || m[2];
        const eur = parseFloat(raw.replace(/,/g, ''));
        if (isNaN(eur)) continue;
        frag.appendChild(document.createTextNode(text.slice(last, m.index)));
        const span = document.createElement('span');
        span.className = 'cvt-price';
        span.dataset.eur = String(eur);
        span.textContent = m[0];
        frag.appendChild(span);
        last = m.index + m[0].length;
      }
      frag.appendChild(document.createTextNode(text.slice(last)));
      node.parentNode?.replaceChild(frag, node);
    });
  }
  function applyCurrency(cur: string) {
    document.querySelectorAll<HTMLElement>('.cvt-price').forEach((el) => {
      const eur = parseFloat(el.dataset.eur || '');
      if (!isNaN(eur)) el.textContent = formatPrice(eur, cur);
    });
  }
  const curLabelEl = document.getElementById('curLabel');
  const curOpts = document.querySelectorAll<HTMLElement>('.cur-opt');
  function selectCurrency(code: string) {
    curOpts.forEach((o) => o.removeAttribute('aria-current'));
    document.querySelector(`.cur-opt[data-code="${code}"]`)?.setAttribute('aria-current', 'true');
    if (curLabelEl) curLabelEl.textContent = code;
    localStorage.setItem('currency', code);
    applyCurrency(code);
  }
  curOpts.forEach((btn) => {
    btn.addEventListener('click', () => {
      selectCurrency(btn.dataset.code || 'EUR');
      curDropdown.close();
    });
  });
  tagPrices();
  selectCurrency(localStorage.getItem('currency') || 'EUR');
</script>
