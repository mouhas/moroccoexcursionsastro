---
import Icon from './Icon.astro';
import { UI, type Lang } from '../site';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = UI[lang];
---
<aside class="filters" id="tour-filters">
  <div class="filters-head">
    <h2><Icon name="tag" class="ico" /> {t.filters}</h2>
    <button type="button" class="clear-filters" data-clear-filters>{t.clearFilters}</button>
  </div>

  <div class="filter-group">
    <label for="sort-select">{t.sortBy}</label>
    <select id="sort-select" data-sort>
      <option value="recommended">{t.sortRecommended}</option>
      <option value="price-low">{t.sortPriceLow}</option>
      <option value="price-high">{t.sortPriceHigh}</option>
      <option value="duration">{t.sortDuration}</option>
    </select>
  </div>

  <div class="filter-group">
    <span class="filter-label">{t.priceRange}</span>
    <label class="filter-opt"><input type="checkbox" data-filter="price" value="0-100" /> {t.priceUnder100}</label>
    <label class="filter-opt"><input type="checkbox" data-filter="price" value="100-300" /> {t.price100to300}</label>
    <label class="filter-opt"><input type="checkbox" data-filter="price" value="300-600" /> {t.price300to600}</label>
    <label class="filter-opt"><input type="checkbox" data-filter="price" value="600-999999" /> {t.price600plus}</label>
  </div>

  <div class="filter-group">
    <span class="filter-label">{t.chooseDuration}</span>
    <label class="filter-opt"><input type="checkbox" data-filter="duration" value="1-1" /> {t.dur1}</label>
    <label class="filter-opt"><input type="checkbox" data-filter="duration" value="2-3" /> {t.dur2to3}</label>
    <label class="filter-opt"><input type="checkbox" data-filter="duration" value="4-7" /> {t.dur4to7}</label>
    <label class="filter-opt"><input type="checkbox" data-filter="duration" value="8-99999" /> {t.dur8plus}</label>
  </div>

  <div class="filter-group">
    <span class="filter-label">{t.tourTypeFilter}</span>
    <label class="filter-opt"><input type="checkbox" data-filter="type" value="private" /> {t.private}</label>
    <label class="filter-opt"><input type="checkbox" data-filter="type" value="group" /> {t.groupTour}</label>
  </div>

  <div class="filter-group">
    <span class="filter-label">{t.ratingFilter}</span>
    <label class="filter-opt"><input type="radio" name="rating" data-filter="rating" value="0" checked /> {t.ratingAny}</label>
    <label class="filter-opt"><input type="radio" name="rating" data-filter="rating" value="4.5" /> 4.5+ <Icon name="star" class="ico sm" /></label>
    <label class="filter-opt"><input type="radio" name="rating" data-filter="rating" value="4" /> 4.0+ <Icon name="star" class="ico sm" /></label>
  </div>

  <p class="filter-count" data-filter-count></p>
  <p class="filter-empty" data-filter-empty style="display:none">{t.noToursMatch}</p>
</aside>

<script define:vars={{ toursFoundLabel: t.toursFound }}>
  document.addEventListener('DOMContentLoaded', function () {
    // The grid this sidebar filters lives later in the DOM than this script
    // tag (a plain synchronous <script>), so it doesn't exist yet at parse
    // time — wait for DOMContentLoaded rather than querying immediately.
    const grid = document.querySelector('[data-tour-grid]');
    const sidebar = document.getElementById('tour-filters');
    if (!grid || !sidebar) return;
    const cards = Array.from(grid.querySelectorAll('.card'));
    const countEl = sidebar.querySelector('[data-filter-count]');
    const emptyEl = sidebar.querySelector('[data-filter-empty]');
    const sortSelect = sidebar.querySelector('[data-sort]');

    function checkedValues(name) {
      return Array.from(sidebar.querySelectorAll(`input[data-filter="${name}"]:checked`)).map((el) => el.value);
    }

    function inRange(val, rangeStr) {
      const [lo, hi] = rangeStr.split('-').map(Number);
      return val >= lo && val <= hi;
    }

    function apply() {
      const priceRanges = checkedValues('price');
      const durationRanges = checkedValues('duration');
      const types = checkedValues('type');
      const minRating = parseFloat(sidebar.querySelector('input[data-filter="rating"]:checked')?.value || '0');

      let visibleCount = 0;
      for (const card of cards) {
        const price = parseFloat(card.getAttribute('data-price') || '');
        const days = parseFloat(card.getAttribute('data-duration-days') || '');
        const type = card.getAttribute('data-tour-type') || '';
        const rating = parseFloat(card.getAttribute('data-rating') || '0');

        let visible = true;
        if (priceRanges.length && !(Number.isFinite(price) && priceRanges.some((r) => inRange(price, r)))) visible = false;
        if (visible && durationRanges.length && !(Number.isFinite(days) && durationRanges.some((r) => inRange(days, r)))) visible = false;
        if (visible && types.length && !types.includes(type)) visible = false;
        if (visible && minRating > 0 && !(rating >= minRating)) visible = false;

        card.style.display = visible ? '' : 'none';
        if (visible) visibleCount++;
      }

      if (countEl) countEl.textContent = `${visibleCount} ${toursFoundLabel}`;
      if (emptyEl) emptyEl.style.display = visibleCount === 0 ? 'block' : 'none';

      const sortMode = sortSelect ? sortSelect.value : 'recommended';
      if (sortMode !== 'recommended') {
        const sorted = cards.slice().sort((a, b) => {
          if (sortMode === 'price-low' || sortMode === 'price-high') {
            const pa = parseFloat(a.getAttribute('data-price') || '') || (sortMode === 'price-low' ? Infinity : -Infinity);
            const pb = parseFloat(b.getAttribute('data-price') || '') || (sortMode === 'price-low' ? Infinity : -Infinity);
            return sortMode === 'price-low' ? pa - pb : pb - pa;
          }
          if (sortMode === 'duration') {
            const da = parseFloat(a.getAttribute('data-duration-days') || '') || Infinity;
            const db = parseFloat(b.getAttribute('data-duration-days') || '') || Infinity;
            return da - db;
          }
          return 0;
        });
        for (const card of sorted) grid.appendChild(card);
      }
    }

    sidebar.addEventListener('change', apply);
    const clearBtn = sidebar.querySelector('[data-clear-filters]');
    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        sidebar.querySelectorAll('input[type="checkbox"]').forEach((el) => { el.checked = false; });
        const anyRating = sidebar.querySelector('input[data-filter="rating"][value="0"]');
        if (anyRating) anyRating.checked = true;
        if (sortSelect) sortSelect.value = 'recommended';
        apply();
      });
    }
    apply();
  });
</script>
