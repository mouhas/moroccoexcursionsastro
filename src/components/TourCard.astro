---
import { UI, type Lang } from '../site';
interface Props {
  href: string;
  title: string;
  price?: number | null;
  duration?: string | null;
  tourType?: string | null;
  tag?: string | null;
  lang: Lang;
  seed?: string;
  urlPath?: string;
  rating?: number | null;
  reviewCount?: number | null;
}
const { href, title, price, duration, tourType, tag, lang, rating, reviewCount } = Astro.props;
const t = UI[lang];
const priceStr = price && price > 0 ? '€' + price.toLocaleString('en-US') : null;
const isGroup = /group|groupe|grupo|gruppo/i.test(tourType ?? '');
const durationDays = duration ? parseInt(duration.match(/\d+/)?.[0] ?? '', 10) || null : null;
---
<article style="display:flex;flex-direction:column;border:1px solid var(--color-divider);border-radius:var(--radius-md);overflow:hidden"
  data-price={price ?? ''} data-duration-days={durationDays ?? ''} data-tour-type={isGroup ? 'group' : 'private'} data-rating={rating ?? ''}>
  <a href={href} aria-label={title} style="display:block;position:relative">
    {tag && <span class="tag tag-accent" style="position:absolute;top:12px;left:12px;z-index:2">{tag}</span>}
    <div class="ph" style="height:190px;border-radius:0;box-shadow:none"><span>photo — {title}</span></div>
  </a>
  <div style="padding:14px 16px 16px;display:flex;flex-direction:column;gap:6px;flex:1">
    {rating
      ? <div style="display:flex;align-items:center;gap:6px">
          <span style="color:var(--color-accent);font-size:13px">★</span>
          <span style="font-size:13px;font-weight:600">{rating.toFixed(1)}</span>
          <span style="font-size:12px;color:var(--color-neutral-600)">({reviewCount ?? 0})</span>
        </div>
      : <p style="font-size:12px;color:var(--color-neutral-600);margin:0">{t.notRated}</p>}
    <h3 style="font-size:17px;margin:0"><a href={href} style="color:inherit;text-decoration:none">{title}</a></h3>
    <p style="font-size:12px;color:var(--color-neutral-600);margin:0 0 6px">{tourType || t.private}{duration ? ' · ' + duration : ''}</p>
    <p style="font-size:12px;color:var(--color-neutral-600);margin:auto 0 0">
      {priceStr ? <>{t.from} <span style="font-size:18px;font-weight:700;color:var(--color-accent-700)">{priceStr}</span></> : <span style="font-weight:600">On request</span>}
    </p>
  </div>
</article>
