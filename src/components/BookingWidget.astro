---
import Icon from './Icon.astro';
import { UI, type Lang } from '../site';

interface PriceTier { people: number; perPerson: number; }
interface AutoPricing { days: number; nights: number; hotelPerNight: number; superiorSurcharge: number; transportPerDay: number; }
interface CampTier { label: string; perPerson: number; }
interface ActivityOption { label: string; prices: { durationLabel: string; price: number }[]; }

interface Props {
  lang: Lang;
  title: string;
  price?: number | null;
  perUnit?: string; // e.g. t.perDay, or '' for tours
  isCar?: boolean;
  pricingMode?: 'group' | 'tiers' | 'auto' | 'activity';
  priceTiers?: PriceTier[];
  autoPricing?: AutoPricing | null;
  campTiers?: CampTier[];
  activityOptions?: ActivityOption[];
  hasDesertExtras?: boolean;
}
const {
  lang, title, price, perUnit = '', isCar = false,
  pricingMode = 'group', priceTiers = [], autoPricing = null,
  campTiers = [], activityOptions = [], hasDesertExtras = false,
} = Astro.props;
const t = UI[lang];
const priceStr = price && price > 0 ? '€' + price.toLocaleString('en-US') : null;
const waNumber = '212673555408';
const wid = 'bk-' + Math.random().toString(36).slice(2, 9);

const canPay = !isCar && (
  (pricingMode === 'group' && !!price && price > 0) ||
  (pricingMode === 'tiers' && priceTiers.length > 0) ||
  (pricingMode === 'auto' && !!autoPricing) ||
  (pricingMode === 'activity' && activityOptions.length > 0)
);
const durationLabels = pricingMode === 'activity' && activityOptions[0] ? activityOptions[0].prices.map((p) => p.durationLabel) : [];
const maxTierPeople = priceTiers.length ? Math.max(...priceTiers.map((p) => p.people)) : 0;
---
<aside class="booking" id={wid}>
  <div class="from">{t.from}</div>
  {priceStr
    ? <div class="amt">{priceStr}<small>{perUnit}</small></div>
    : <div class="amt" style="font-size:22px">On request</div>}
  {isCar && <div class="row"><Icon name="globe" /> {t.category}</div>}

  <div class="bk-field">
    <label>{isCar ? t.pickupDate : t.preferredDate}</label>
    <input type="date" form={wid + '-form'} name="date" required />
  </div>
  {isCar ? (
    <div class="bk-field">
      <label>{t.returnDate}</label>
      <input type="date" form={wid + '-form'} name="dateEnd" />
    </div>
  ) : (
    <div class="bk-field">
      <label>{t.travelers}</label>
      <div class="bk-stepper">
        <button type="button" data-step="-1" aria-label="minus">−</button>
        <input type="number" data-travelers name="travelers_display" value="2" min="1" max="30" readonly />
        <button type="button" data-step="1" aria-label="plus">+</button>
      </div>
    </div>
  )}

  {canPay && (
    <div class="pay-box">
      {pricingMode === 'auto' && (
        <div class="calc-row">
          <label>{t.accommodation}</label>
          <div class="pay-toggle">
            <label class="pay-opt"><input type="radio" name={`acc-${wid}`} value="standard" checked /> {t.accStandard}</label>
            <label class="pay-opt"><input type="radio" name={`acc-${wid}`} value="superior" /> {t.accSuperior}</label>
          </div>
        </div>
      )}

      {pricingMode === 'group' && campTiers.length > 0 && (
        <div class="calc-row">
          <label>{t.accommodation}</label>
          <div class="pay-toggle">
            {campTiers.map((tier, i) => (
              <label class="pay-opt">
                <input type="radio" name={`camp-${wid}`} value={String(tier.perPerson)} checked={i === 0} /> {tier.label} (€{tier.perPerson}/{t.perPerson})
              </label>
            ))}
          </div>
        </div>
      )}

      {pricingMode === 'activity' && activityOptions.length > 0 && (
        <div class="calc-row">
          <label>{t.vehicleType}</label>
          <div class="pay-toggle">
            {activityOptions.map((opt, i) => (
              <label class="pay-opt"><input type="radio" name={`vehicle-${wid}`} value={opt.label} checked={i === 0} /> {opt.label}</label>
            ))}
          </div>
          <label style="margin-top:10px;display:block">{t.chooseDuration}</label>
          <div class="pay-toggle">
            {durationLabels.map((label, i) => (
              <label class="pay-opt"><input type="radio" name={`duration-${wid}`} value={label} checked={i === 0} /> {label}</label>
            ))}
          </div>
        </div>
      )}

      {hasDesertExtras && pricingMode !== 'activity' && (
        <div class="calc-row extras">
          <label>{t.extras}</label>
          <div class="extra-item">
            <span><b>{t.extraQuadSingle}</b><small>{t.extraQuadSingleNote}</small></span>
            <div class="bk-stepper sm"><button type="button" data-extra-step="quadSingle" data-step="-1">−</button><input type="number" data-extra="quadSingle" value="0" min="0" max="20" readonly /><button type="button" data-extra-step="quadSingle" data-step="1">+</button></div>
          </div>
          <div class="extra-item">
            <span><b>{t.extraQuadShared}</b><small>{t.extraQuadSharedNote}</small></span>
            <div class="bk-stepper sm"><button type="button" data-extra-step="quadShared" data-step="-1">−</button><input type="number" data-extra="quadShared" value="0" min="0" max="20" readonly /><button type="button" data-extra-step="quadShared" data-step="1">+</button></div>
          </div>
          <div class="extra-item">
            <span><b>{t.extraBuggy}</b><small>{t.extraBuggyNote}</small></span>
            <div class="bk-stepper sm"><button type="button" data-extra-step="buggy" data-step="-1">−</button><input type="number" data-extra="buggy" value="0" min="0" max="20" readonly /><button type="button" data-extra-step="buggy" data-step="1">+</button></div>
          </div>
        </div>
      )}

      <div class="pay-toggle">
        <label class="pay-opt"><input type="radio" name={`paymode-${wid}`} value="deposit" checked /> {t.payDeposit}</label>
        <label class="pay-opt"><input type="radio" name={`paymode-${wid}`} value="full" /> {t.payFull}</label>
      </div>
      <div class="pay-total"><span>{t.totalDue}</span><b data-pay-total>€0</b></div>
      <p class="contact-quote" data-contact-quote>{t.contactForQuote}</p>
      <div id={`pp-${wid}`} class="pp-container" data-pp-container></div>
      <p class="pp-note">{t.paypalSandboxNote}</p>
      <div class="pay-ok" data-pay-ok>{t.paymentSuccess}</div>
    </div>
  )}

  <p class="assure sep">{t.orRequestInstead}</p>
  <form class="bk-form" id={wid + '-form'} data-title={title}>
    <div class="bk-field">
      <label>{t.fullName}</label>
      <input type="text" name="name" required />
    </div>
    <div class="bk-field">
      <label>{t.email}</label>
      <input type="email" name="email" required />
    </div>
    <div class="bk-field">
      <label>{t.phone}</label>
      <input type="tel" name="phone" />
    </div>
    <div class="bk-field">
      <label>{t.message}</label>
      <textarea name="message" placeholder={t.messagePlaceholder}></textarea>
    </div>

    <button type="submit" class="btn" style="width:100%;justify-content:center;margin-top:6px">{t.sendEmail}</button>
    <div class="bk-alt">
      <a class="btn wa" target="_blank" rel="noopener" data-wa-link href={`https://wa.me/${waNumber}`}>
        <Icon name="whatsapp" class="ico sm" style="fill:#fff;stroke:none" /> {t.chatWhatsapp}
      </a>
    </div>
    <div class="bk-ok" data-ok>{t.bookSuccess}</div>
  </form>
  <p class="assure">Our team replies within a few hours and is happy to help you plan the perfect trip.</p>
</aside>

{canPay && <script src="https://www.paypal.com/sdk/js?client-id=sb&currency=EUR" data-pp-sdk></script>}

<script define:vars={{ wid, waNumber, price, canPay, title, pricingMode, priceTiers, autoPricing, maxTierPeople, activityOptions }}>
  (function () {
    const root = document.getElementById(wid);
    if (!root) return;
    const form = document.getElementById(wid + '-form');
    const stepBtns = root.querySelectorAll('.bk-stepper button[data-step]:not([data-extra-step])');
    const stepInput = root.querySelector('[data-travelers]');
    const totalEl = root.querySelector('[data-pay-total]');
    const ppContainer = root.querySelector('[data-pp-container]');
    const contactQuote = root.querySelector('[data-contact-quote]');

    function travelers() {
      return stepInput ? (parseInt(stepInput.value, 10) || 1) : 1;
    }
    function extraQty(name) {
      const el = root.querySelector(`[data-extra="${name}"]`);
      return el ? parseInt(el.value, 10) || 0 : 0;
    }
    function extrasTotal() {
      return extraQty('quadSingle') * 50 + extraQty('quadShared') * 75 + extraQty('buggy') * 130;
    }
    // Returns the tour cost (excluding extras), or null if this group size
    // needs a custom quote (beyond the tiers we have data for).
    function tourTotal() {
      const n = travelers();
      if (pricingMode === 'tiers') {
        if (!priceTiers.length) return null;
        if (maxTierPeople && n > maxTierPeople) return null;
        let best = priceTiers[0];
        for (const tier of priceTiers) {
          if (tier.people <= n && tier.people >= best.people) best = tier;
        }
        return best.perPerson * n;
      }
      if (pricingMode === 'auto') {
        if (!autoPricing) return null;
        const accEl = root.querySelector(`input[name="acc-${wid}"]:checked`);
        const superior = accEl && accEl.value === 'superior';
        const rate = autoPricing.hotelPerNight + (superior ? autoPricing.superiorSurcharge : 0);
        const hotel = rate * n * autoPricing.nights;
        const transport = autoPricing.transportPerDay * autoPricing.days;
        return hotel + transport;
      }
      if (pricingMode === 'activity') {
        // Flat rate for the chosen vehicle + duration — not multiplied by travelers,
        // since the listed price already covers that vehicle for that time slot.
        if (!activityOptions.length) return null;
        const vehicleEl = root.querySelector(`input[name="vehicle-${wid}"]:checked`);
        const durationEl = root.querySelector(`input[name="duration-${wid}"]:checked`);
        const opt = activityOptions.find((o) => o.label === (vehicleEl && vehicleEl.value)) || activityOptions[0];
        const rate = opt.prices.find((p) => p.durationLabel === (durationEl && durationEl.value)) || opt.prices[0];
        return rate ? rate.price : null;
      }
      // group mode: flat per-person price (or selected camp tier) × travelers
      const campEl = root.querySelector(`input[name="camp-${wid}"]:checked`);
      const perPerson = campEl ? parseFloat(campEl.value) : price;
      return perPerson ? perPerson * n : null;
    }
    function amount() {
      const base = tourTotal();
      if (base === null) return null;
      const grand = base + extrasTotal();
      const mode = root.querySelector(`input[name="paymode-${wid}"]:checked`);
      return mode && mode.value === 'deposit' ? grand * 0.1 : grand;
    }
    function refreshTotal() {
      const amt = amount();
      const needsQuote = amt === null;
      if (contactQuote) contactQuote.style.display = needsQuote ? 'block' : 'none';
      if (ppContainer) ppContainer.style.display = needsQuote ? 'none' : '';
      const totalRow = totalEl ? totalEl.closest('.pay-total') : null;
      if (totalRow) totalRow.style.display = needsQuote ? 'none' : 'flex';
      if (totalEl && !needsQuote) totalEl.textContent = '€' + amt.toFixed(2);
    }
    stepBtns.forEach((b) => b.addEventListener('click', () => {
      if (!stepInput) return;
      const delta = parseInt(b.getAttribute('data-step'), 10);
      const val = Math.max(1, Math.min(30, travelers() + delta));
      stepInput.value = String(val);
      refreshTotal();
    }));
    root.querySelectorAll('[data-extra-step]').forEach((b) => b.addEventListener('click', () => {
      const name = b.getAttribute('data-extra-step');
      const el = root.querySelector(`[data-extra="${name}"]`);
      if (!el) return;
      const delta = parseInt(b.getAttribute('data-step'), 10);
      el.value = String(Math.max(0, Math.min(20, (parseInt(el.value, 10) || 0) + delta)));
      refreshTotal();
    }));
    root.querySelectorAll(`input[name="paymode-${wid}"], input[name="acc-${wid}"], input[name="camp-${wid}"], input[name="vehicle-${wid}"], input[name="duration-${wid}"]`).forEach((r) => r.addEventListener('change', refreshTotal));
    refreshTotal();

    function buildMessage() {
      const data = new FormData(form);
      const dateInput = root.querySelector('input[name="date"]');
      const lines = [`Booking request: ${title}`, `Date: ${(dateInput && dateInput.value) || ''}`];
      const dateEnd = root.querySelector('input[name="dateEnd"]');
      if (dateEnd && dateEnd.value) lines.push(`Return date: ${dateEnd.value}`);
      if (stepInput) lines.push(`Travelers: ${stepInput.value}`);
      const accEl = root.querySelector(`input[name="acc-${wid}"]:checked`);
      if (accEl) lines.push(`Accommodation: ${accEl.value}`);
      const campEl = root.querySelector(`input[name="camp-${wid}"]:checked`);
      if (campEl) lines.push(`Camp: €${campEl.value}/person`);
      const vehicleEl = root.querySelector(`input[name="vehicle-${wid}"]:checked`);
      if (vehicleEl) lines.push(`Vehicle: ${vehicleEl.value}`);
      const durationEl = root.querySelector(`input[name="duration-${wid}"]:checked`);
      if (durationEl) lines.push(`Duration: ${durationEl.value}`);
      if (extraQty('quadSingle')) lines.push(`Quad (single ATV): ${extraQty('quadSingle')}`);
      if (extraQty('quadShared')) lines.push(`Quad (shared ATV): ${extraQty('quadShared')}`);
      if (extraQty('buggy')) lines.push(`Dune buggy: ${extraQty('buggy')}`);
      lines.push(`Name: ${data.get('name') || ''}`);
      lines.push(`Email: ${data.get('email') || ''}`);
      if (data.get('phone')) lines.push(`Phone: ${data.get('phone')}`);
      if (data.get('message')) lines.push(`Message: ${data.get('message')}`);
      return lines.join('\n');
    }

    const waLink = root.querySelector('[data-wa-link]');
    root.addEventListener('input', () => {
      if (!waLink) return;
      waLink.href = `https://wa.me/${waNumber}?text=${encodeURIComponent(buildMessage())}`;
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form.checkValidity()) { form.reportValidity(); return; }
      const body = buildMessage();
      const subject = `Booking request: ${title}`;
      window.location.href = `mailto:MoroccoExcursions@Gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      const ok = root.querySelector('[data-ok]');
      if (ok) ok.style.display = 'block';
    });

    if (canPay) {
      const renderPaypal = () => {
        if (!window.paypal) return;
        window.paypal.Buttons({
          style: { layout: 'vertical', color: 'gold', shape: 'pill', label: 'paypal' },
          createOrder: (_data, actions) => actions.order.create({
            purchase_units: [{
              description: title.slice(0, 120),
              amount: { currency_code: 'EUR', value: (amount() || 0).toFixed(2) },
            }],
          }),
          onApprove: (_data, actions) => actions.order.capture().then(() => {
            const ok = root.querySelector('[data-pay-ok]');
            if (ok) ok.style.display = 'block';
          }),
        }).render(`#pp-${wid}`);
      };
      const sdk = document.querySelector('script[data-pp-sdk]');
      if (window.paypal) renderPaypal();
      else if (sdk) sdk.addEventListener('load', renderPaypal);
    }
  })();
</script>
