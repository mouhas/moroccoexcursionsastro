---
import Base from '../../../layouts/Base.astro';
import TourCard from '../../../components/TourCard.astro';
import TourFilters from '../../../components/TourFilters.astro';
import { getCollection } from 'astro:content';
import { LANGS, UI, base, type Lang } from '../../../site';

export function getStaticPaths() {
  return LANGS.filter((l) => l !== 'en').map((l) => ({ params: { lang: l } }));
}
const lang = Astro.params.lang as Lang;
const t = UI[lang];
const tours = await getCollection('site', (e) => e.data.lang === lang && e.data.section === 'tours');
tours.sort((a, z) => (z.data.price ?? -1) - (a.data.price ?? -1));
const home = '/' + lang + '/';
const rated = tours.filter((e) => e.data.rating);
const avgRating = rated.length ? rated.reduce((s, e) => s + (e.data.rating ?? 0), 0) / rated.length : null;
const descriptions: Record<string, string> = {
  fr: 'Parcourez tous nos circuits et excursions au Maroc — désert du Sahara, randonnées à dos de chameau, excursions à la journée et grands voyages de plusieurs jours. Privé, flexible et 100 % local.',
  es: 'Explora todos nuestros tours y excursiones por Marruecos — desierto del Sáhara, paseos en camello, excursiones de un día y grandes viajes de varios días. Privado, flexible y 100 % local.',
  it: 'Scopri tutti i nostri tour ed escursioni in Marocco — deserto del Sahara, escursioni in cammello, gite di un giorno e grandi viaggi di più giorni. Privato, flessibile e 100% locale.',
  'pt-br': 'Veja todos os nossos tours e excursões pelo Marrocos — deserto do Saara, passeios de camelo, excursões de um dia e grandes viagens de vários dias. Privado, flexível e 100% local.',
};
const toursListingAlternates = Object.fromEntries(LANGS.map((l) => [l, base(l) + '/tours']));
---
<Base title={`${t.allTours} | Morocco Excursions`} lang={lang} alternates={toursListingAlternates} description={descriptions[lang]} section="tours">
  <section style="padding:40px 40px 24px">
    <span class="mono" style="color:var(--color-accent-700)">{tours.length} tours · 100% private</span>
    <h1 style="font-size:clamp(30px,4.4vw,52px);line-height:1.04;margin:12px 0 12px">{t.allTours}</h1>
    <p style="font-size:17px;line-height:1.6;color:var(--color-neutral-700);max-width:600px;margin:0">
      {avgRating ? `Rated ${avgRating.toFixed(1)}/5 by real travellers. ` : ''}Every departure is private, guided by a local, and fully customisable.
    </p>
  </section>
  <section style="padding:0 40px 88px;display:grid;grid-template-columns:264px 1fr;gap:28px;align-items:start">
    <TourFilters lang={lang} />
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:20px" data-tour-grid>
      {tours.map((e) => (
        <TourCard href={'/' + e.data.urlPath} title={e.data.title} price={e.data.price}
          duration={e.data.duration} lang={lang} seed={e.data.pslug} urlPath={e.data.urlPath} tourType={e.data.tourType}
          rating={e.data.rating} reviewCount={e.data.reviewCount} />
      ))}
    </div>
  </section>
</Base>

<style>
  @media (max-width: 900px) {
    section[style*="264px"] { grid-template-columns: 1fr !important; }
  }
</style>
