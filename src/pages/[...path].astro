import { galleryFor } from '../lib/images';
import { getSettings } from '../lib/settings';

export async function getStaticPaths() {
  const all = await getCollection('site');
  return all.map((entry) => ({ params: { path: entry.data.urlPath }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const lang = d.lang as Lang;
const t = UI[lang];
const b = base(lang);
const settings = await getSettings();
const { Content } = await entry.render();

const isTour = d.section === 'tours';
const isCar = d.section === 'cars';
const isPage = d.section === 'pages';

// Three content pages get the reference theme's own bespoke page patterns
// (About / Transport / Contact) instead of the generic prose template —
// matched by pslug since each language has its own translated slug.
const ABOUT_SLUGS = ['travel-agency', 'agence', 'agencia', 'agenzia'];
const CAR_HUB_SLUGS = ['morocco-rental-cars', 'location-de-voitures', 'aluguel-de-carro', 'noleggio-auto', 'alquiler-de-coches'];
const CONTACT_SLUGS = ['contact', 'contacto', 'contatto'];
const DESERT_SLUGS = ['morocco-desert-tours', 'circuit-desert-maroc', 'viaje-desierto-marruecos', 'tour-deserto-marocco', 'excursoes-deserto-marrocos'];
const isAboutPage = isPage && ABOUT_SLUGS.includes(d.pslug);
const isCarHubPage = isPage && CAR_HUB_SLUGS.includes(d.pslug);
const isContactPage = isPage && CONTACT_SLUGS.includes(d.pslug);
const isDesertPage = isPage && DESERT_SLUGS.includes(d.pslug);

// Real desert tours, found by matching each language's own translated
// keywords against the real tour titles — not a fabricated hand-picked
// list. Sorted by rating so the best-reviewed trips show first.
const DESERT_KEYWORDS: Record<Lang, RegExp> = {
  en: /desert|sahara|merzouga|zagora|dunes|erg chebbi/i,
  fr: /désert|sahara|merzouga|zagora|dunes/i,
  es: /desierto|sahara|merzouga|zagora|dunas/i,
  it: /deserto|sahara|merzouga|zagora|dune/i,
  'pt-br': /deserto|saara|merzouga|zagora|dunas/i,
};
const desertTours = isDesertPage
  ? (await getCollection('site', (e) => e.data.lang === lang && e.data.section === 'tours' && DESERT_KEYWORDS[lang].test(e.data.title)))
      .sort((a, z) => (z.data.rating ?? 0) - (a.data.rating ?? 0) || (z.data.reviewCount ?? 0) - (a.data.reviewCount ?? 0))
      .slice(0, 9)
  : [];

// Real fleet, used by the car-hub page's "Our fleet" grid — the current
// page's own language, since every car is now translated into all 4 langs.
const fleetCars = isCarHubPage
  ? (await getCollection('site', (e) => e.data.lang === lang && e.data.section === 'cars'))
  : [];

// The real, separate DMC page — linked from the About page's DMC teaser
// section instead of duplicating its content.
const dmcEntry = isAboutPage
  ? (await getCollection('site', (e) => e.data.lang === lang && e.data.pslug.startsWith('dmc-')))[0]
  : null;

// Real star-rating breakdown and most-mentioned real guide names, computed
// from every review actually stored across the site (not invented figures)
// — used for the About page's rating-breakdown bars and team section.
let ratingBars: { stars: number; pct: number }[] = [];
let realTeam: string[] = [];
if (isAboutPage) {
  const allEntries = await getCollection('site', (e) => e.data.lang === 'en');
  const counts: Record<number, number> = {};
  let total = 0;
  const nameCounts: Record<string, number> = {};
  const NAME_RE = /\b(Hassan|Omar|Ahmed|Said|Rachid|Youssef|Ali|Karim|Brahim|Mohammed|Mohamed|Hamid|Aziz|Mustapha)\b/g;
  for (const e of allEntries) {
    for (const r of e.data.reviews) {
      counts[r.stars] = (counts[r.stars] ?? 0) + 1;
      total++;
      const matches = (r.text + ' ' + r.title).match(NAME_RE) ?? [];
      for (const nm of matches) nameCounts[nm] = (nameCounts[nm] ?? 0) + 1;
    }
  }
  ratingBars = [5, 4, 3, 2, 1].map((s) => ({ stars: s, pct: total ? Math.round(((counts[s] ?? 0) / total) * 100) : 0 }));
  realTeam = Object.entries(nameCounts).sort((a, b) => b[1] - a[1]).slice(0, 4).map(([n]) => n);
}

