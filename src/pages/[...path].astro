              <a href={'/' + dmcEntry.data.urlPath} style="font-size:15px;font-weight:600">{sc.dmcLink} →</a>
            </div>
            {sc.dmcServices && (
              <div style="display:grid;gap:14px">
                {sc.dmcServices.split(', ').map((svc: string) => (
                  <div style="font-size:14px;line-height:1.5;color:var(--color-neutral-800);padding-bottom:14px;border-bottom:1px solid var(--color-divider)">{svc}</div>
                ))}
              </div>
            )}
          </div>
        </section>
      )}
      {realTeam.length > 0 && (
        <section style="padding:0 40px 24px">
          <span class="mono" style="color:var(--color-accent-700)">{sc.teamEyebrow}</span>
          <h2 style="font-size:clamp(24px,3.2vw,36px);margin:12px 0 20px">{sc.teamHeading}</h2>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:20px">
            {realTeam.map((name: string) => (
              <div>
