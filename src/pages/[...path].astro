            <div class="card" style="border-radius:var(--radius-lg);padding:28px"><Icon name="shield" class="ico" style="color:var(--color-accent)" /><h3 style="font-size:17px;margin:12px 0 4px">{t.trustLocal}</h3><p style="font-size:14px;color:var(--color-neutral-700);margin:0">{t.trustLocalSub}</p></div>
            <div class="card" style="border-radius:var(--radius-lg);padding:28px"><Icon name="compass" class="ico" style="color:var(--color-accent)" /><h3 style="font-size:17px;margin:12px 0 4px">{t.trustBespoke}</h3><p style="font-size:14px;color:var(--color-neutral-700);margin:0">{t.trustBespokeSub}</p></div>
            <div class="card" style="border-radius:var(--radius-lg);padding:28px"><Icon name="chat" class="ico" style="color:var(--color-accent)" /><h3 style="font-size:17px;margin:12px 0 4px">{t.trustReply}</h3><p style="font-size:14px;color:var(--color-neutral-700);margin:0">{t.trustReplySub}</p></div>
            <div class="card" style="border-radius:var(--radius-lg);padding:28px"><Icon name="check" class="ico" style="color:var(--color-accent)" /><h3 style="font-size:17px;margin:12px 0 4px">{t.trustSecure}</h3><p style="font-size:14px;color:var(--color-neutral-700);margin:0">{t.trustSecureSub}</p></div>
          </div>
