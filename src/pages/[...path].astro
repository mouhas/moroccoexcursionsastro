        </div>
        <div class="ph" style="min-height:340px"><span>{sc.aboutPhotoCaption}</span></div>
      </section>
      <section style="padding:0 40px 24px">
        {d.iconGrid.length > 0 ? (
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px">
            {d.iconGrid.map((f: { icon: string; title: string; text: string }) => (
