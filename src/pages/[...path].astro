);

// Stable, deterministic "random" order seeded by this tour's slug — every tour
// gets its own unique similar-tours combination instead of always the same three.
function seededShuffle<T>(arr: T[], seed: string): T[] {
  let h = 0;
  for (const c of seed) h = (h * 31 + c.charCodeAt(0)) >>> 0;
  const a = arr.slice();
  for (let i = a.length - 1; i > 0; i--) {
    h = (Math.imul(h, 1103515245) + 12345) >>> 0;
    const j = h % (i + 1);
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}
const priced = siblings.filter((e) => e.data.price);
const similar = seededShuffle(priced, d.pslug).slice(0, 3);

// Previous / next navigation, ordered alphabetically by slug for a stable sequence.
const ordered = [...siblings, entry].sort((a, z) => a.data.pslug.localeCompare(z.data.pslug));
const curIdx = ordered.findIndex((e) => e.data.urlPath === d.urlPath);
const prevEntry = ordered.length > 1 ? ordered[(curIdx - 1 + ordered.length) % ordered.length] : null;
const nextEntry = ordered.length > 1 ? ordered[(curIdx + 1) % ordered.length] : null;

const homeHref = b + '/';
const priceStr = d.price && d.price > 0 ? '€' + d.price.toLocaleString('en-US') : null;
const generalReviews = GENERAL_REVIEWS[lang] ?? GENERAL_REVIEWS.en;
const galleryImages = galleryFor(d.urlPath);
const galleryTiles = [d.pslug, d.pslug + '-2', d.pslug + '-3', d.pslug + '-4'];
const pageHero = isPage ? galleryFor(d.urlPath)[0] : undefined;

// Day-trip hub pages ("morocco-9-day-trips") get a live grid of real,
// current tours of that exact duration instead of relying only on the
// static in-body table (which can go stale as tours are added/removed).
const dayTripDays = isPage ? d.pslug.match(/^morocco-(\d+)-day-trips$/)?.[1] : null;
const dayTripTours = dayTripDays
