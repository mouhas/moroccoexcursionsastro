                <p style="font-size:16px;font-weight:600;margin:12px 0 2px">{name}</p>
                <p style="font-size:14px;color:var(--color-neutral-600);margin:0">{sc.guideRole}</p>
              </div>
            ))}
          </div>
        </section>
      )}
      <section style="padding:0 40px 24px">
        <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:20px;flex-wrap:wrap">
          <div>
            <span class="mono" style="color:var(--color-accent-700)">{t.readReviews}</span>
            <h2 style="font-size:clamp(24px,3.2vw,36px);margin:12px 0 0">{t.customerReviews}</h2>
          </div>
          <div style="display:flex;align-items:center;gap:8px">
            <span style="color:var(--color-accent);font-size:18px">★</span>
            <span style="font-family:var(--font-heading);font-weight:700;font-size:24px">5.0</span>
            <span style="font-size:13px;color:var(--color-neutral-600)">· 820+ {t.reviewsLabel}</span>
          </div>
        </div>
        <div style="display:grid;grid-template-columns:260px 1fr;gap:32px;align-items:start">
          <div style="border:1px solid var(--color-divider);border-radius:var(--radius-lg);padding:22px;display:grid;gap:10px">
            {ratingBars.map((b: { stars: number; pct: number }) => (
              <div style="display:grid;grid-template-columns:26px 1fr 38px;gap:10px;align-items:center;font-size:13px;color:var(--color-neutral-700)">
                <span>{b.stars}★</span>
                <span style="height:7px;border-radius:999px;background:var(--color-neutral-200)"><span style={`display:block;width:${b.pct}%;height:7px;border-radius:999px;background:var(--color-accent)`}></span></span>
                <span>{b.pct}%</span>
              </div>
            ))}
            <p style="font-size:12.5px;line-height:1.6;color:var(--color-neutral-600);margin:10px 0 0;padding-top:12px;border-top:1px solid var(--color-divider)">{sc.ratingBreakdownNote}</p>
          </div>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px">
            {(GENERAL_REVIEWS[lang] ?? GENERAL_REVIEWS.en).map((r) => (
              <article style="border:1px solid var(--color-divider);border-radius:var(--radius-lg);padding:22px;display:flex;flex-direction:column;gap:10px">
                <div style="color:var(--color-accent);font-size:14px">★★★★★</div>
                <p style="font-size:14.5px;line-height:1.6;color:var(--color-neutral-800);margin:0">&ldquo;{r.text}&rdquo;</p>
                <p style="font-size:13px;color:var(--color-neutral-600);margin:auto 0 0;padding-top:10px;border-top:1px solid var(--color-divider)"><b style="color:var(--color-text)">{r.name}</b>{r.place ? ' · ' + r.place : ''}</p>
              </article>
            ))}
          </div>
        </div>
        <div style="text-align:center;margin-top:24px"><a href={b + '/reviews'} class="btn btn-secondary">{t.readReviews} →</a></div>
      </section>
    </>
  )}

  {isCarHubPage && (
    <section style="padding:40px 40px 32px;display:grid;grid-template-columns:1.05fr 1fr;gap:28px;align-items:center">
      <div>
        <span class="mono" style="color:var(--color-accent-700)">{sc.carsEyebrow}</span>
        <h1 style="font-size:clamp(28px,4vw,52px);line-height:1.04;margin:12px 0 14px">{d.title}</h1>
        <p style="font-size:17px;line-height:1.65;color:var(--color-neutral-700);max-width:520px;margin:0 0 24px">{sc.carsLead}</p>
        <div style="display:flex;gap:12px;flex-wrap:wrap">
          <a href={settings.whatsappHref} target="_blank" rel="noopener" class="btn btn-primary" style="font-size:16px;padding:15px 30px">{sc.carsGetQuote}</a>
          <a href="#fleet" class="btn btn-secondary" style="font-size:16px;padding:15px 30px">{sc.carsSeeVehicles}</a>
        </div>
      </div>
      <div class="ph" style="min-height:300px"><span>{sc.carsPhotoCaption}</span></div>
    </section>
  )}

  {isContactPage && (
    <section style="padding:56px 40px 40px;display:grid;grid-template-columns:1fr 1fr;gap:56px;max-width:1160px;margin:0 auto">
      <div>
        <span class="mono" style="color:var(--color-accent-700)">{sc.contactEyebrow}</span>
        <h1 style="font-size:clamp(30px,4.4vw,52px);line-height:1.04;margin:14px 0 16px">{d.title}</h1>
        <p style="font-size:17px;line-height:1.6;color:var(--color-neutral-700);max-width:420px;margin:0 0 12px">{sc.contactLead}</p>
        <p class="mono" style="color:var(--color-neutral-600)">{sc.responseLabel}: {t.trustReplySub}</p>
      </div>
      <div class="card elev-md" style="border-radius:var(--radius-lg);padding:36px">
        <form id="contact-form" style="display:grid;gap:16px">
          <input type="text" name="website" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" aria-hidden="true" />
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
            <div class="field"><label>{sc.firstName}</label><input class="input" name="firstName" required /></div>
            <div class="field"><label>{sc.lastName}</label><input class="input" name="lastName" /></div>
          </div>
          <div class="field"><label>{sc.email}</label><input class="input" type="email" name="email" required /></div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
            <div class="field"><label>{sc.travelDates}</label><input class="input" name="dates" /></div>
            <div class="field"><label>{sc.travellers}</label><input class="input" name="travellers" /></div>
          </div>
          <div class="field"><label>{sc.wantMsg}</label><textarea class="input" name="message" rows="4"></textarea></div>
          <button type="submit" class="btn btn-primary btn-block">{sc.sendEnquiry}</button>
        </form>
      </div>
      <script define:vars={{ contactEmail: settings.email, submitEndpoint: settings.submitEndpoint }}>
        document.getElementById('contact-form')?.addEventListener('submit', (e) => {
          e.preventDefault();
          const form = e.target;
          const data = new FormData(form);
          const lines = [
            'First name: ' + (data.get('firstName') || ''),
            'Last name: ' + (data.get('lastName') || ''),
            'Email: ' + (data.get('email') || ''),
            'Travel dates: ' + (data.get('dates') || ''),
            'Travellers: ' + (data.get('travellers') || ''),
            '',
            (data.get('message') || ''),
          ];
          const subject = 'Enquiry from ' + (data.get('firstName') || 'website');
          const fullName = [data.get('firstName'), data.get('lastName')].filter(Boolean).join(' ');

          if (submitEndpoint) {
            fetch(submitEndpoint, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                type: 'message',
                name: fullName || data.get('firstName') || '',
                email: data.get('email') || '',
                subject,
                message: data.get('message') || '',
                raw: lines.join('\n'),
                website: data.get('website') || '',
              }),
            }).catch(() => {});
          }

          window.location.href = 'mailto:' + contactEmail + '?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(lines.join('\n'));
        });
      </script>
    </section>
  )}

  {isDesertPage && (
    <>
      <section style="padding:40px 40px 24px;display:grid;grid-template-columns:1.05fr 1fr;gap:28px;align-items:center">
        <div>
          <span class="mono" style="color:var(--color-accent-700)">{sc.desertEyebrow}</span>
          <h1 style="font-size:clamp(28px,4vw,52px);line-height:1.04;margin:12px 0 0;max-width:20ch">{d.title}</h1>
        </div>
        <div class="ph" style="min-height:280px"><span>{sc.desertPhotoCaption}</span></div>
      </section>
      {desertTours.length > 0 && (
        <section style="padding:0 40px 24px">
          <h2 style="font-size:clamp(22px,3vw,32px);margin:0 0 20px">{sc.desertGridHeading}</h2>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px">
            {desertTours.map((e) => (
              <TourCard href={'/' + e.data.urlPath} title={e.data.title} price={e.data.price}
                duration={e.data.duration} lang={lang} urlPath={e.data.urlPath} tourType={e.data.tourType}
                rating={e.data.rating} reviewCount={e.data.reviewCount} />
            ))}
          </div>
          <div style="text-align:center;margin-top:28px"><a href={b + '/tours'} class="btn btn-secondary">{t.viewAll} →</a></div>
        </section>
      )}
    </>
  )}

  {(isTour || isCar) && (
    <div class="wrap tour-head">
      <div class="crumbs">
        <a href={homeHref}>{t.home}</a>
        {isTour && <> · <a href={b + '/tours'}>{t.allTours}</a></>}
        {isCar && <> · <a href={carRentalHref(lang)}>{CAR_RENTAL_LABEL[lang]}</a></>}
        · {d.title}
      </div>
      <h1>{d.title}</h1>

      <div class="tour-info-row">
        {d.duration && <div class="ti"><Icon name="clock" class="ico" /><span><small>{t.duration}</small><b>{d.duration}</b></span></div>}
        {d.tourCode && <div class="ti"><Icon name="tag" class="ico" /><span><small>{t.tourCode}</small><b>{d.tourCode}</b></span></div>}
        {isTour && d.tourType && <div class="ti"><Icon name="user" class="ico" /><span><small>{t.tourType}</small><b>{d.tourType}</b></span></div>}
        {isCar && d.carCategory && <div class="ti"><Icon name="car" class="ico" /><span><small>{t.category}</small><b>{d.carCategory}</b></span></div>}
        <a href="#reviews" class="ti link">
          {d.rating
            ? <><span class="stars"><Icon name="star" /></span><span><small>{d.rating.toFixed(1)} / 5</small><b>{d.reviewCount ?? 0} {t.reviewsLabel}</b></span></>
            : <><Icon name="star" class="ico" style="color:#c7cfd8" /><span><b>{t.notRated}</b></span></>}
        </a>
        {isTour && (
          <button type="button" class="ti link print-btn" data-print-page>
            <Icon name="download" class="ico" /><span><b>{t.downloadPdf}</b></span>
          </button>
        )}
      </div>

      <div class="gallery">
        <div class="gallery-main">
          <GalleryTile image={galleryImages[0]} seed={galleryTiles[0]} label={d.title} eager />
        </div>
        <div class="gallery-side">
          {galleryTiles.slice(1).map((s, i) => (
            <div class="gallery-tile">
              <GalleryTile image={galleryImages[i + 1]} seed={s} label={`${d.title} — view ${i + 2}`} />
            </div>
          ))}
        </div>
      </div>

      {(() => {
        // Placeholder illustrations only make sense for the 4 "hero" slots above;
        // once real photos exist for the rest, show them too — until then, no
        // point cluttering the page with more gradient placeholders.
        const extra = galleryImages.slice(4).filter((img) => img.exists);
        return extra.length > 0 && (
          <div class="gallery-more">
            {extra.map((img) => (
              <div class="gallery-tile sm"><GalleryTile image={img} seed={img.file} label={img.alt} /></div>
            ))}
          </div>
        );
      })()}
    </div>
  )}

  {isTour && (
    <nav class="subnav" id="subnav">
      <div class="wrap">
        <a href="#overview" data-nav="overview">{t.tabOverview}</a>
        {d.itinerary.length > 0 && <a href="#itinerary" data-nav="itinerary">{t.tabItinerary}</a>}
        {(d.included.length > 0 || d.excluded.length > 0) && <a href="#included" data-nav="included">{t.tabIncluded}</a>}
        {d.mapUrl && <a href="#map" data-nav="map">{t.tabMap}</a>}
        <a href="#reviews" data-nav="reviews">{t.tabReviews}</a>
        {d.faqs.length > 0 && <a href="#faq" data-nav="faq">{t.tabFaq}</a>}
      </div>
    </nav>
  )}

  <div class={isPage ? 'wrap layout full' : 'wrap layout'} style={isPage ? 'padding:0 40px 40px' : undefined}>
    <article class="prose">
      {isPage && (
        <div class="md-prose">
          <Content />
        </div>
      )}

      {dayTripTours.length > 0 && (
        <div class="sec" style="margin-top:16px">
          <h2 style="font-size:clamp(24px,3vw,34px);margin:0 0 20px">{t.bookableNow}</h2>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:20px">
            {dayTripTours.map((e) => (
              <TourCard href={'/' + e.data.urlPath} title={e.data.title} price={e.data.price}
                duration={e.data.duration} lang="en" seed={e.data.pslug} urlPath={e.data.urlPath} tourType={e.data.tourType}
                rating={e.data.rating} reviewCount={e.data.reviewCount} />
            ))}
          </div>
        </div>
      )}

      {isCarHubPage && d.carListings.length > 0 && (
        <div class="sec" id="fleet" style="margin-top:16px">
          <h2 style="font-size:clamp(24px,3vw,34px);margin:0 0 20px">{sc.ourFleet}</h2>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:20px">
            {d.carListings.map((car: { icon: string; title: string; text: string; specs: string[]; price: string | null; href: string | null; bookHref: string | null }) => (
              <a href={car.href ?? car.bookHref ?? '#'} style="display:flex;flex-direction:column;border:1px solid var(--color-divider);border-radius:var(--radius-md);overflow:hidden;color:inherit;text-decoration:none">
                <div class="ph" style="height:150px;border-radius:0;box-shadow:none"><span>photo — {car.title}</span></div>
                <div style="padding:14px 16px 16px;display:flex;flex-direction:column;gap:6px;flex:1">
                  <h3 style="font-size:16px;margin:0"><Icon name={car.icon} class="ico sm" style="vertical-align:-2px;margin-right:4px;color:var(--color-accent)" />{car.title}</h3>
                  <p style="font-size:12.5px;line-height:1.5;color:var(--color-neutral-700);margin:0">{car.text}</p>
                  {car.specs.length > 0 && (
                    <p style="font-size:12px;color:var(--color-neutral-700);margin:6px 0 0;padding-top:8px;border-top:1px solid var(--color-divider)">{car.specs.slice(0, 3).join(' · ')}</p>
                  )}
                  {car.price
                    ? <p style="font-size:12px;color:var(--color-neutral-600);margin:auto 0 0">{t.from} <span style="font-size:17px;font-weight:700;color:var(--color-accent-700)">{car.price}</span></p>
                    : <p style="font-size:12px;color:var(--color-neutral-600);margin:auto 0 0">{t.onRequest}</p>}
                </div>
              </a>
            ))}
          </div>
          <p style="font-size:13px;color:var(--color-neutral-600);margin:16px 0 0">{sc.fleetNote}</p>
        </div>
      )}

      {isCarHubPage && d.carListings.length === 0 && fleetCars.length > 0 && (
        <div class="sec" id="fleet" style="margin-top:16px">
          <h2 style="font-size:clamp(24px,3vw,34px);margin:0 0 20px">{sc.ourFleet}</h2>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:20px">
            {fleetCars.map((car) => (
              <a href={'/' + car.data.urlPath} style="display:flex;flex-direction:column;border:1px solid var(--color-divider);border-radius:var(--radius-md);overflow:hidden;color:inherit;text-decoration:none">
                <div class="ph" style="height:150px;border-radius:0;box-shadow:none"><span>photo — {car.data.title}</span></div>
                <div style="padding:14px 16px 16px;display:flex;flex-direction:column;gap:6px;flex:1">
                  <h3 style="font-size:16px;margin:0">{car.data.title}</h3>
                  {car.data.carCategory && <p style="font-size:12px;color:var(--color-neutral-600);margin:0">{car.data.carCategory}</p>}
                  {car.data.carFeatures?.length > 0 && (
                    <p style="font-size:12px;color:var(--color-neutral-700);margin:6px 0 0;padding-top:8px;border-top:1px solid var(--color-divider)">{car.data.carFeatures.slice(0, 3).join(' · ')}</p>
                  )}
                  {car.data.price
                    ? <p style="font-size:12px;color:var(--color-neutral-600);margin:auto 0 0">{t.from} <span style="font-size:17px;font-weight:700;color:var(--color-accent-700)">€{car.data.price}</span> / {sc.day}</p>
                    : <p style="font-size:12px;color:var(--color-neutral-600);margin:auto 0 0">{t.onRequest}</p>}
                </div>
              </a>
            ))}
          </div>
          <p style="font-size:13px;color:var(--color-neutral-600);margin:16px 0 0">{sc.fleetNote}</p>
        </div>
      )}

      {isCarHubPage && (
        <div class="sec" style="margin-top:40px;background:var(--color-surface);border-radius:var(--radius-lg);padding:32px;display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:32px">
          <div><h3 style="font-size:18px;margin:0 0 8px">{sc.availTitle}</h3><p style="font-size:14px;line-height:1.6;color:var(--color-neutral-700);margin:0">{sc.availNote}</p></div>
          <div><h3 style="font-size:18px;margin:0 0 8px">{sc.paymentTitle}</h3><p style="font-size:14px;line-height:1.6;color:var(--color-neutral-700);margin:0">{sc.paymentNote}</p></div>
          <div><h3 style="font-size:18px;margin:0 0 8px">{sc.includedTitle}</h3><p style="font-size:14px;line-height:1.6;color:var(--color-neutral-700);margin:0">{sc.includedNote}</p></div>
        </div>
      )}

      {isPage && !isCarHubPage && d.faqs.length > 0 && (
        <div class="sec" style="margin-top:40px">
          <h2 style="font-size:clamp(24px,3vw,34px);margin:0 0 20px">{t.frequentlyAsked}</h2>
          <div style="display:grid;gap:2px">
            {d.faqs.map((f: { q: string; aHtml: string }) => (
              <details class="faq" style="border-bottom:1px solid var(--color-divider);padding:16px 0">
                <summary style="font-size:16px;font-weight:600;cursor:pointer">{f.q}</summary>
                <div class="md-prose" style="padding-top:10px;font-size:15px" set:html={f.aHtml} />
              </details>
            ))}
          </div>
        </div>
      )}

      {isCarHubPage && d.faqs.length > 0 && (
        <div class="sec" id="carfaq" style="margin-top:40px;display:grid;grid-template-columns:280px 1fr;gap:40px;align-items:start">
          <div style="position:sticky;top:100px">
            <h2 style="font-size:clamp(24px,3vw,32px);margin:0 0 10px">{t.frequentlyAsked}</h2>
            <p style="font-size:14.5px;line-height:1.6;color:var(--color-neutral-700);margin:0 0 16px">{t.trustReplySub}</p>
            <a href={settings.whatsappHref} target="_blank" rel="noopener" class="btn btn-secondary">{sc.askQuestion}</a>
          </div>
          <div style="display:grid;gap:10px">
            {d.faqs.map((f: { q: string; aHtml: string }, i: number) => (
              <details class="faq" open={i === 0} style="border:1px solid var(--color-divider);border-radius:var(--radius-lg);padding:18px 22px">
                <summary style="font-family:var(--font-heading);font-weight:var(--font-heading-weight,500);font-size:16px;cursor:pointer">{f.q}</summary>
                <div class="md-prose" style="padding-top:10px;font-size:15px" set:html={f.aHtml} />
              </details>
            ))}
          </div>
        </div>
      )}

      {isTour && (
        <div id="overview" class="sec">
          <h2>{t.tabOverview}</h2>

          {(pickupTime || d.autoPricing?.nights || d.hasDesertExtras || d.cancellation || d.languagesSpoken) && (
            <div class="kbyg">
              <h3>{t.knowBeforeYouGo}</h3>
              <div class="kbyg-grid">
                {pickupTime && <div class="kbyg-item"><Icon name="clock" class="ico" /><span><b>{t.pickupTimeLabel}</b><small>{pickupTime}</small></span></div>}
                {typeof d.autoPricing?.nights === 'number' && (
                  <div class="kbyg-item"><Icon name="cal" class="ico" /><span><b>{t.nightsIncluded}</b><small>{d.autoPricing.nights} — {t.nightsIncludedNote}</small></span></div>
                )}
                {d.cancellation && <div class="kbyg-item"><Icon name="shield" class="ico" /><span><b>{t.freeCancellation}</b><small>{d.cancellation}</small></span></div>}
                {d.languagesSpoken && <div class="kbyg-item"><Icon name="globe" class="ico" /><span><b>{t.languagesLabel}</b><small>{d.languagesSpoken}</small></span></div>}
                {d.hasDesertExtras && (
                  <div class="kbyg-item"><Icon name="compass" class="ico" /><span><b>{t.optionalActivities}</b><small>{t.optionalActivitiesNote}</small></span></div>
                )}
              </div>
            </div>
          )}

          <div set:html={d.overviewHtml} />

          {d.highlights.length > 0 && (
            <>
              <h3 style="font-size:17px;margin:22px 0 12px">{t.highlights}</h3>
              <div class="check-grid">
                {d.highlights.map((h: string) => (
                  <div class="check-item"><Icon name="check" class="ico sm" /> {h}</div>
                ))}
              </div>
            </>
          )}

          {d.priceRows.length > 1 && (
            <>
              <h3 style="font-size:17px;margin:26px 0 12px">{d.priceHeading || t.pricing}</h3>
              <div class="price-table-wrap">
                <table class="price-table">
                  <thead><tr>{d.priceRows[0].map((c: string) => <th>{c}</th>)}</tr></thead>
                  <tbody>
                    {d.priceRows.slice(1).map((row: string[]) => <tr>{row.map((c) => <td>{c}</td>)}</tr>)}
                  </tbody>
                </table>
              </div>
            </>
          )}

          {d.notes.length > 0 && (
            <div class="notes-box">
              <h4>{d.notesHeading || t.goodToKnow}</h4>
              <ol>
                {d.notes.map((n: string) => <li set:html={n} />)}
              </ol>
            </div>
          )}
        </div>
      )}

      {isTour && d.itinerary.length > 0 && (
        <div id="itinerary" class="sec">
          <h2>{t.dayItinerary}</h2>
          <div class="accordion">
            {d.itinerary.map((day: { title: string; html: string }, i: number) => (
              <details class="acc-item" open={i === 0}>
                <summary><span class="num">{i + 1}</span> {day.title} <Icon name="chevron" class="ico chev" /></summary>
                <div class="acc-body" set:html={day.html} />
              </details>
            ))}
          </div>
        </div>
      )}

      {isTour && (d.included.length > 0 || d.excluded.length > 0) && (
        <div id="included" class="sec">
          <h2>{t.tabIncluded}</h2>
          <div class="incl-grid">
            {d.included.length > 0 && (
              <div class="incl-col yes">
                <h3><Icon name="check" class="ico" /> {t.included}</h3>
                {d.included.map((i: string) => <div class="check-item"><Icon name="check" class="ico sm" /> {i}</div>)}
              </div>
            )}
            {d.excluded.length > 0 && (
              <div class="incl-col no">
                <h3><Icon name="cross" class="ico" /> {t.excluded}</h3>
                {d.excluded.map((i: string) => <div class="check-item no"><Icon name="cross" class="ico sm" /> {i}</div>)}
              </div>
            )}
          </div>
        </div>
      )}

      {isTour && d.mapUrl && (
        <div id="map" class="sec">
          <h2>{t.tourMap}</h2>
          {mapRoute && <p class="map-route">{mapRoute.routeText}</p>}
          <div class="map-embed">
            <button type="button" class="map-load-btn" data-map-src={d.mapUrl} data-map-title={t.tourMap}>
              <Icon name="pin" class="ico" />
              {t.loadMap}
            </button>
          </div>
          {mapRoute && (
            <a class="map-directions-link" href={mapRoute.directionsUrl} target="_blank" rel="noopener noreferrer">
              {t.openInMaps}
            </a>
          )}
        </div>
      )}

      {isTour && (
        <div id="reviews" class="sec">
          <h2>{t.customerReviews}</h2>
          {d.rating && (
            <div class="rev-summary">
              <div class="big rating-num">{d.rating.toFixed(1)}</div>
              <div class="meta">
                <span class="stars"><Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" /></span>
                <span>{d.reviewCount ?? d.reviews.length} {t.reviewsLabel}</span>
              </div>
              {d.ratingBreakdown && (
                <div class="rating-bars">
                  {([
                    [t.ratingHotels, d.ratingBreakdown.hotels],
                    [t.ratingGuides, d.ratingBreakdown.guides],
                    [t.ratingTransport, d.ratingBreakdown.transport],
                    [t.ratingActivities, d.ratingBreakdown.activities],
                  ] as [string, number][]).map(([label, score]) => (
                    <div class="rating-bar-row">
                      <span class="rb-label">{label}</span>
                      <span class="rb-track"><span class="rb-fill" style={`width:${(score / 5) * 100}%`}></span></span>
                      <span class="rb-score">{score.toFixed(1)}</span>
                    </div>
                  ))}
                </div>
              )}
            </div>
          )}
          {d.reviews.length > 0 ? (
            <>
              {d.reviews.map((r: { name: string; date: string; stars: number; title: string; text: string; likes: number }) => (
                <div class="rev-card">
                  <div class="head">
                    <span class="av">{r.name[0]}</span>
                    <span class="who"><b>{r.name}</b><small>{r.date}</small></span>
                    <span class="stars">{Array.from({ length: r.stars }).map(() => <Icon name="star" />)}</span>
                  </div>
                  {r.title && <div class="title">{r.title}</div>}
                  <p>{r.text}</p>
                  {r.likes > 0 && <div class="likes"><Icon name="heart" class="ico sm" /> {r.likes}</div>}
                </div>
              ))}
            </>
          ) : (
            <>
              <p class="sec-sub" style="margin:0 0 16px">{t.noReviewsYet} {t.generalReviewsNote}</p>
              {generalReviews.map((r) => (
                <div class="rev-card">
                  <div class="head">
                    <span class="av">{r.name[0]}</span>
                    <span class="who"><b>{r.name}</b>{r.place && <small>{r.place}</small>}</span>
                    <span class="stars"><Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" /></span>
                  </div>
                  <p>{r.text}</p>
                </div>
              ))}
              <div class="center" style="margin-top:10px"><a href={b + '/reviews'} class="btn blue">{t.readReviews} →</a></div>
            </>
          )}
        </div>
      )}

      {isTour && d.faqs.length > 0 && (
        <div id="faq" class="sec">
          <h2>{t.frequentlyAsked}</h2>
          <div class="accordion">
            {d.faqs.map((f: { q: string; aHtml: string }) => (
              <details class="acc-item faq">
                <summary>{f.q} <Icon name="chevron" class="ico chev" /></summary>
                <div class="acc-body" set:html={f.aHtml} />
              </details>
            ))}
          </div>
        </div>
      )}

      {isCar && (
        <div class="sec">
          {d.carCategory && (
            <>
              <h2>{t.category}</h2>
              <p class="sec-sub" style="margin-bottom:6px">{d.carCategory}</p>
            </>
          )}
          {d.carFeatures.length > 0 && (
            <>
              <h3 style="font-size:17px;margin:20px 0 10px">{t.features}</h3>
              <div class="spec-grid">
                {d.carFeatures.map((f: string) => (
                  <div class="spec"><Icon name="check" class="ico" /><span>{f}</span></div>
                ))}
              </div>
            </>
          )}
        </div>
      )}

      {(isTour || isCar) && (prevEntry || nextEntry) && (
        <div class="prevnext">
          {prevEntry
            ? <a href={'/' + prevEntry.data.urlPath} class="pn-link prev"><Icon name="chevron" class="ico pn-chev" /><span><small>{t.prevTour}</small><b>{prevEntry.data.title}</b></span></a>
            : <span />}
          {nextEntry
            ? <a href={'/' + nextEntry.data.urlPath} class="pn-link next"><span><small>{t.nextTour}</small><b>{nextEntry.data.title}</b></span><Icon name="chevron" class="ico pn-chev" /></a>
            : <span />}
        </div>
      )}
    </article>

    {(isTour || isCar) && (
      <BookingWidget
        lang={lang}
        title={d.title}
        price={d.price}
        perUnit={isCar ? t.perDay : (priceStr ? ' ' + t.perPerson : '')}
        isCar={isCar}
        pricingMode={d.pricingMode}
        priceTiers={d.priceTiers}
        autoPricing={d.autoPricing}
        campTiers={d.campTiers}
        activityOptions={d.activityOptions}
        hasDesertExtras={d.hasDesertExtras}
      />
    )}
  </div>

  {(isTour || isCar) && similar.length > 0 && (
    <div class="newtheme">
      <section style="padding:56px max(40px, calc((100% - 1180px) / 2))">
        <h2 style="font-size:clamp(24px,3.2vw,34px);margin:0 0 28px">{t.similar}</h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px">
          {similar.map((e) => (
            <TourCard href={'/' + e.data.urlPath} title={e.data.title} price={e.data.price}
              duration={e.data.duration} lang={lang} seed={e.data.pslug} urlPath={e.data.urlPath} tourType={e.data.tourType}
              rating={e.data.rating} reviewCount={e.data.reviewCount} />
          ))}
        </div>
      </section>
    </div>
  )}

  {isTour && (
    <script>
      (function () {
        const links = Array.from(document.querySelectorAll('.subnav a[data-nav]'));
        if (!links.length) return;
        const sections = links
          .map((a) => document.getElementById(a.getAttribute('data-nav') || ''))
          .filter((el) => !!el);
        const setActive = (id) => {
          links.forEach((a) => a.classList.toggle('active', a.getAttribute('data-nav') === id));
        };
        const io = new IntersectionObserver(
          (entries) => {
            const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
            if (visible.length) setActive(visible[0].target.id);
          },
          { rootMargin: '-120px 0px -70% 0px', threshold: 0 }
        );
        sections.forEach((s) => io.observe(s));
      })();

      // Map facade: the Google Maps embed iframe is only created on click, so it
      // never costs bytes/requests for visitors who don't open it.
      document.addEventListener('click', (e) => {
        const btn = e.target?.closest?.('.map-load-btn');
        if (!btn) return;
        const src = btn.getAttribute('data-map-src');
        if (!src) return;
        const iframe = document.createElement('iframe');
        iframe.src = src;
        iframe.width = '100%';
        iframe.height = '380';
        iframe.style.border = '0';
        iframe.loading = 'lazy';
        iframe.referrerPolicy = 'no-referrer-when-downgrade';
        iframe.title = btn.getAttribute('data-map-title') || 'Map';
        btn.replaceWith(iframe);
      });

      // "Download PDF" just triggers the browser's native print dialog, which on
      // every modern browser offers "Save as PDF" — no server-side PDF generation
      // needed. A print stylesheet hides nav/booking/etc.; beforeprint/afterprint
      // force every accordion open (and restore it after) so the full itinerary
      // and FAQ print even when collapsed — a CSS-only override of a closed
      // <details> isn't reliable across browsers, so this uses the real attribute.
      document.addEventListener('click', (e) => {
        if (e.target?.closest?.('[data-print-page]')) window.print();
      });
      window.addEventListener('beforeprint', () => {
        document.querySelectorAll('.acc-item').forEach((d) => {
          d.dataset.wasOpen = d.open ? '1' : '0';
          d.open = true;
        });
      });
      window.addEventListener('afterprint', () => {
        document.querySelectorAll('.acc-item').forEach((d) => {
          d.open = d.dataset.wasOpen === '1';
          delete d.dataset.wasOpen;
        });
      });
    </script>
  )}
</Base>

<style>
  .soft2{background:var(--blue-lt)}
  .md-prose :global(h2){font-family:var(--font-heading);font-weight:var(--font-heading-weight,400);font-size:26px;color:var(--color-text);margin:34px 0 12px}
  .md-prose :global(h3){font-family:var(--font-heading);font-weight:var(--font-heading-weight,400);font-size:20px;margin:26px 0 10px}
  .md-prose :global(h4),.md-prose :global(h5),.md-prose :global(h6){font-size:16px;margin:20px 0 8px}
  .md-prose :global(p){font-size:16px;line-height:1.7;color:var(--color-neutral-800);margin:0 0 14px}
  .md-prose :global(ul),.md-prose :global(ol){margin:0 0 16px 22px;color:var(--color-neutral-800)}
  .md-prose :global(li){margin:6px 0;font-size:16px;line-height:1.6}
  .md-prose :global(table){border-collapse:collapse;width:100%;margin:16px 0;font-size:14px}
  .md-prose :global(td){border-bottom:1px solid var(--color-divider);padding:12px}
  .md-prose :global(tbody tr:nth-child(odd)){background:var(--color-neutral-100)}
  .md-prose :global(th){background:var(--color-accent-700);color:#fff;font-family:var(--font-heading);font-weight:var(--font-heading-weight,600);padding:13px 12px;text-align:left}
  .md-prose :global(th:first-child){border-radius:10px 0 0 0}
  .md-prose :global(th:last-child){border-radius:0 10px 0 0}
  .md-prose :global(a){color:var(--color-accent-700)}
  .md-prose :global(a:hover){color:var(--color-accent)}
  .md-prose :global(img){border-radius:var(--radius-md);margin:14px 0}
  .md-prose :global(hr){border:none;border-top:1px solid var(--color-divider);margin:26px 0}
  .md-prose :global(blockquote){background:var(--color-accent-100);border-left:4px solid var(--color-accent);padding:14px 18px;border-radius:var(--radius-sm);margin:22px 0;font-size:15px}
</style>
