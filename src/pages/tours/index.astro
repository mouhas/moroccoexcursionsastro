---
import Base from '../../layouts/Base.astro';
import TourCard from '../../components/TourCard.astro';
import { getCollection } from 'astro:content';
import { UI } from '../../site';
const t = UI.en;
const tours = await getCollection('site', (e) => e.data.lang === 'en' && e.data.section === 'tours');
tours.sort((a, z) => (z.data.price ?? -1) - (a.data.price ?? -1));
const rated = tours.filter((e) => e.data.rating);
const avgRating = rated.length ? rated.reduce((s, e) => s + (e.data.rating ?? 0), 0) / rated.length : null;
---
<Base title="All Tours & Excursions | Morocco Excursions" lang="en" langAlternates section="tours"
  description="Browse all Morocco tours and excursions — Sahara desert trips, camel treks, day excursions and grand multi-day journeys. Private, flexible, 100% local.">
  <section class="pagehead">
    <div class="wrap">
      <div class="crumbs"><a href="/">Home</a> · Tours</div>
      <h1>{t.allTours}</h1>
      <div class="sub">
        <span>{tours.length} tours &amp; excursions</span>
        {avgRating && <span>{avgRating.toFixed(1)}/5 average rating</span>}
        <span>100% private</span>
      </div>
    </div>
  </section>
  <section class="pad">
    <div class="wrap">
      <div class="grid">
        {tours.map((e) => (
          <TourCard href={'/' + e.data.urlPath} title={e.data.title} price={e.data.price}
            duration={e.data.duration} lang="en" seed={e.data.pslug}
            rating={e.data.rating} reviewCount={e.data.reviewCount} />
        ))}
      </div>
    </div>
  </section>
</Base>
